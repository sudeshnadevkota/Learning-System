<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="student.master.cs" Inherits="Learning_System.students.student" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Student Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
   <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

</head>
<body>
    <div class="container-fluid">
        <div class="row" style="box-shadow: 0 1px 4px rgba(0,0,0,0.2);">
            <div class="col-md-2" style="padding: 10px 0px; text-align: center;">
                <a href="default_student.aspx">
                    <img src="images/logo.png" width="100" />
                </a>
            </div>
            <div class="col-md-8" style="display: flex; justify-content: center; align-items: center;">
                <asp:DataList ID="username" runat="server">
                    <ItemTemplate>
                        <h5>Welcome <%# Eval("full_name") %></h5>
                    </ItemTemplate>
                </asp:DataList>   
            </div>
            <div class="col-md-2" style="display: flex; justify-content: center; align-items: center;">
                <a href="../logout.aspx" class="btn btn-sm btn-danger">logout</a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-2" style="box-shadow: 0 1px 4px rgba(0,0,0,0.2); padding-top: 15px;">
                <ul style="list-style: none">
                    <li><i class="bi bi-grid"> </i> <a href="default_student.aspx" style="text-decoration:none; color: black;"> Modules</a></li>
                    <li><i class="bi bi-file-earmark-text"> </i> <a href="#" style="text-decoration:none; color: black;"> Notices</a></li>

                </ul>
            </div>
            <div class="col-md-10" style="height: 86vh; overflow-y: auto;">
                <form id="form1" runat="server">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </form>
            </div>
        </div>
        <p style="text-align: center;">Powered by RAS</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>
