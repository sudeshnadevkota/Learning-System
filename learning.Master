<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="learning.master.cs" Inherits="Learning_System.learning" %>


<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Texas College Virtual System</title>
    <link href="style.css" rel="stylesheet" />
 <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Apply font family to the entire body */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
        }

        .hover-effect:hover {
            transform: scale(1.05);
            transition: transform 0.3s ease;
        }


        .hover-effect:hover {
            transform: scale(1.05);
            transition: transform 0.3s ease;
        }

        .card-img-top {
            object-fit: cover;
            height: 150px;
            width: 100%;
        }

        .card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }


        /* Apply to main headings */
        h1, h2, h3 {
            font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
        }

        /* Apply to paragraphs */
        p {
            font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
        }

        /* Apply to list items */
        li {
            font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
        }

        :root {
            --bs-primary: #28346f;
            --bs-primary-rgb: 40, 52, 111;
        }


        .btn-primary {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }

            .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
                background-color: #1e2754;
                border-color: #1e2754;
            }

            .btn-primary:hover,
            .btn-primary:focus,
            .btn-primary:active {
                background-color: #0b0b0b;
                border-color: #1e2754;
            }

        .bg-primary {
            background-color: var(--bs-primary) !important;
        }

        .text-primary {
            color: var(--bs-primary) !important;
        }

        .navbar-nav {
            margin: auto;
        }

            .navbar-nav li {
                margin-left: 15px;
                margin-right: 15px;
            }

        @media (max-width: 767.98px) {
            .offcanvas-body {
                margin-top: 1rem !important;
            }
        }


        .hover-effect {
            position: relative;
            transition: transform 0.3s ease-in-out;
        }

            .hover-effect:hover {
                transform: translateY(-10px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            }

        .social-links {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .hover-effect:hover .social-links {
            opacity: 1;
        }

        .card-body {
            position: relative;
            padding-bottom: 50px; /* Add some padding to ensure space for the social links */
        }


        .instructor-card {
            position: relative;
            overflow: hidden;
            margin-bottom: 20px;
        }

            .instructor-card img {
                width: 100%;
                height: 300px;
                object-fit: cover;
            }

        .social-icons {
            position: absolute;
            right: -40px;
            top: 70px;
            transition: right 0.3s ease;
        }

        .instructor-card:hover .social-icons {
            right: 10px;
        }

        .social-icons a {
            display: block;
            margin-bottom: 10px;
            background: white;
            padding: 5px;
            border-radius: 50%;
            text-align: center;
            width: 30px;
            height: 30px;
            background: #28346f;
            color: white;
        }

        .instructor-name {
            font-weight: bold;
            margin-top: 10px;
            margin-bottom: 0;
        }

        .instructor-role {
            color: #888;
            font-size: 0.9em;
        }

        .custom-hover:hover {
            text-decoration: underline;
            color: #28346f;
            transition: color 0.3s ease-in-out;
        }

        .custom-hover a:hover {
            color: #28346f !important;
        }


        .instructor-card {
            position: relative;
            overflow: hidden;
            margin-bottom: 20px;
        }

            .instructor-card img {
                width: 100%;
                height: 300px;
                object-fit: cover;
            }

        .social-icons {
            position: absolute;
            right: -40px;
            top: 70px;
            transition: right 0.3s ease;
        }

        .instructor-card:hover .social-icons {
            right: 25px;
        }

        .social-icons a {
            display: block;
            margin-bottom: 10px;
            background: white;
            padding: 5px;
            border-radius: 50%;
            text-align: center;
            width: 30px;
            height: 30px;
       
            background-color: var(--bs-primary);
            color: white;
        }

        .instructor-name {
            font-weight: bold;
            margin-top: 10px;
            margin-bottom: 0;
        }

        .instructor-role {
            color: #888;
            font-size: 0.9em;
        }


        .carousel .carousel-item {
            color: #999;
            overflow: hidden;
            min-height: 120px;
            font-size: 13px;
        }

        .carousel .media img {
            width: 80px;
            height: 80px;
            display: block;
            border-radius: 50%;
        }

        .carousel .testimonial {
            padding: 0 15px 0 60px;
            position: relative;
        }

            .carousel .testimonial::before {
                content: "\201C";
                font-family: Arial, sans-serif;
                color: #e2e2e2;
                font-weight: bold;
                font-size: 68px;
                line-height: 54px;
                position: absolute;
                left: 15px;
                top: 0;
            }

        .carousel .overview b {
            text-transform: uppercase;
            color: #1c47e3;
        }

        .carousel-indicators {
            bottom: -40px;
        }

            .carousel-indicators [data-bs-target], .carousel-indicators [data-bs-target].active {
                width: 20px;
                height: 20px;
                border-radius: 50%;
                margin: 1px 3px;
                box-sizing: border-box;
            }

            .carousel-indicators [data-bs-target] {
                background: #e2e2e2;
                border: 4px solid #fff;
            }

                .carousel-indicators [data-bs-target].active {
                    color: #fff;
                    background: #1c47e3;
                    border: 5px double;
                }
        /*  .nima-card {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .button-container {
            position: absolute;
            bottom: 0;
            top:0rem;
            left: 0;
            right: 0;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }
        .nima-card:hover .button-container {
            transform: translateY(0);
        }*/

        .nima-card {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .nima-card img {
                transition: transform 0.3s ease;
            }

            .nima-card:hover img {
                transform: scale(1.1); /* Optional: zoom image slightly on hover */
            }

        .button-container {
            position: absolute;
            bottom: 0;
            left: 0;
            top: 2.5rem;
            right: 0;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

        .nima-card:hover .button-container {
            transform: translateY(0);
        }

        @media (max-width: 576px) {
            .nima-card {
                width: 100% !important;
                height: 20rem; /* Ensure full width on small screens */
            }
        }




       /* FOOTER */

.footer-custom{
    background:linear-gradient(135deg,#0B1F66,#081547) !important;
    color:white !important;
    padding:50px 20px 25px;
}

.footer-text{
    font-size:14px;
    color:#d8ddf0 !important;
}

.footer-custom p,
.footer-custom a{
    font-size:14px;
    color:#d8ddf0 !important;
    text-decoration:none;
    transition:.3s;
}

.footer-custom h3{
    font-size:18px;
    color:white !important;
    font-weight:700;
    margin-bottom:18px;
}

.custom-hover:hover{
    color:#F6B400 !important;
}

.custom-p-hover:hover{
    color:#F6B400 !important;
}
    </style>
</head>

