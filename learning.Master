<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="learning.master.cs" Inherits="Learning_System.learning" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Texas College Virtual System</title>
    
    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Base Reset & Typography */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: "Segoe UI", Arial, sans-serif; background-color: #F5F7FD; display: flex; flex-direction: column; min-height: 100vh; }

        /* Modern Navbar Styling */
        .navbar {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            padding: 12px 0 !important;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            color: #28346f !important;
            padding: 0 15px !important;
            transition: color 0.3s ease;
        }

        .navbar-nav .nav-link:hover { color: #F6B400 !important; }

        /* Enhanced Login Button */
        .login-btn {
            background: linear-gradient(135deg, #0B1F66, #1e2754) !important;
            border: none !important;
            color: white !important;
            padding: 10px 28px !important;
            border-radius: 50px !important;
            font-weight: 600 !important;
            transition: all 0.4s ease !important;
            box-shadow: 0 4px 15px rgba(11, 31, 102, 0.2) !important;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(11, 31, 102, 0.35) !important;
        }

        /* Footer */
        footer {
            background-color: #081547 !important;
            color: rgba(255,255,255,0.6) !important;
            padding: 30px 20px;
            text-align: center;
            font-size: 13px;
            margin-top: auto;
        }

        /* Main Content Spacing */
        .main-content { padding-top: 80px; flex: 1; }
    </style>
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager2" runat="server"></asp:ScriptManager>

        <nav class="navbar navbar-expand-lg fixed-top shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="Default.aspx">
                    <img src="slide/logo.png" alt="logo" width="140" />
                </a>
                
                <button class="navbar-toggler shadow-none border-0" type="button" data-bs-toggle="offcanvas" 
                        data-bs-target="#offcanvasNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="sidebar offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar">
                    <div class="offcanvas-header border-bottom">
                        <h5 class="offcanvas-title text-primary">Texas Portal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                    </div>
                    
                    <div class="offcanvas-body">
                        <ul class="navbar-nav mx-auto align-items-center">
                            <li class="nav-item"><a href="https://texasattendance.com/Admin/Dashboard.aspx" class="nav-link">Attendance</a></li>
                            <li class="nav-item"><a href="https://certificate.texascollegenepal.com/Default.aspx" class="nav-link">Certificate</a></li>
                            <li class="nav-item"><a href="/" class="nav-link">Leave</a></li>
                            <li class="nav-item"><a href="https://texasjobportal.com/default.aspx" class="nav-link">Jobs</a></li>
                            <li class="nav-item"><a href="/" class="nav-link">Notice Board</a></li>
                        </ul>

                        <div class="d-flex align-items-center mt-3 mt-lg-0">
                            <asp:LinkButton ID="Linklogin" runat="server" CssClass="btn login-btn" OnClick="Linklogin_Click">
                                Login <i class="fas fa-sign-in-alt ms-2"></i>
                            </asp:LinkButton>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <div class="main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </div>

        <footer>
            <p>&copy; 2026 Texas College of Management and IT. All rights reserved.</p>
        </footer>
    </form>
</body>
</html>