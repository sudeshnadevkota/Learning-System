<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="upload.master.cs" Inherits="Learning_System.Mba_Admin.upload" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" />
    <link href="mcsdash.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #0B1F66;
            --secondary: #081547;
            --pink: #FF2D8D;
            --yellow: #F6B400;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f4f6fb;
            margin: 0;
        }

        /* ══════════════════════════════
           TOP NAVBAR
        ══════════════════════════════ */
        .top-navbar {
            position: fixed;
            top: 0; left: 0;
            width: 100%;
            height: 64px;
            background: #fff;
            border-bottom: 1px solid rgba(11,31,102,0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            z-index: 1100;
        }

        .top-navbar-logo a { display: flex; align-items: center; }
        .top-navbar-logo img { width: 9rem; height: 3.5rem; object-fit: contain; }

        .top-navbar-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0B1F66;
            letter-spacing: 0.5px;
        }

        .top-navbar-right { display: flex; align-items: center; gap: 10px; }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            color: rgba(11,31,102,0.6);
            background: rgba(11,31,102,0.05);
            border: 1px solid rgba(11,31,102,0.1);
            border-radius: 20px;
            padding: 5px 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .live-dot {
            width: 7px; height: 7px;
            background: #4ade80;
            border-radius: 50%;
            animation: livepulse 1.5s infinite;
        }

        @keyframes livepulse {
            0%,100% { opacity: 1 }
            50%      { opacity: 0.3 }
        }

        .top-navbar-right .btn-primary {
            font-size: 12px !important;
            font-weight: 600 !important;
            background: #FF2D8D !important;
            border-color: #FF2D8D !important;
            border-radius: 8px !important;
            padding: 6px 16px !important;
            letter-spacing: 0.5px;
            transition: opacity .15s;
        }
        .top-navbar-right .btn-primary:hover { opacity: 0.88; }

        /* ══════════════════════════════
           MENU NAVBAR
        ══════════════════════════════ */
        #menu {
            position: fixed;
            top: 64px; left: 0;
            width: 100%;
            height: auto;
            min-height: 52px;
            background: linear-gradient(90deg, #0B1F66, #1a3499);
            z-index: 1050;
            padding: 0 1.5rem;
            border-bottom: 2px solid #FF2D8D;
            display: flex;
            align-items: center;
        }

        #menu .navbar-toggler {
            border: 1px solid rgba(255,255,255,0.3) !important;
            border-radius: 8px;
            padding: 5px 10px;
        }

        #menu .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255%2C255%2C255%2C0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        #menu ul.navbar-nav,
        #menu .navbar-nav {
            display: flex; flex-direction: row; flex-wrap: wrap;
            list-style: none; margin: 0; padding: 0; gap: 2px;
        }

        #menu ul li, #menu .navbar-nav li { position: relative; }

        #menu ul li a,
        #menu .navbar-nav > li > a {
            display: flex; align-items: center;
            padding: 14px 16px;
            font-size: 12.5px; font-weight: 600;
            color: rgba(255,255,255,0.85) !important;
            text-decoration: none;
            letter-spacing: 0.3px;
            border-radius: 0;
            transition: color .15s, background .15s;
            white-space: nowrap;
        }

        #menu ul li a:hover,
        #menu .navbar-nav > li > a:hover {
            color: #fff !important;
            background: rgba(255,45,141,0.18);
        }

        #menu ul li.active > a,
        #menu ul li a.selected {
            color: #FF2D8D !important;
            border-bottom: 2px solid #FF2D8D;
        }

        #menu ul ul,
        #menu .dropdown-menu {
            display: none;
            position: absolute; top: 100%; left: 0;
            min-width: 240px;
            background: #0B1F66;
            border: 1px solid rgba(255,255,255,0.08);
            border-top: 2px solid #FF2D8D;
            border-radius: 0 0 10px 10px;
            padding: 6px 0;
            z-index: 9999;
            list-style: none;
        }

        #menu ul li:hover > ul,
        #menu ul li:focus-within > ul { display: block; }

        #menu ul ul li a,
        #menu .dropdown-menu .dropdown-item {
            padding: 10px 18px !important;
            font-size: 12.5px !important;
            font-weight: 500 !important;
            color: rgba(255,255,255,0.8) !important;
            background: transparent !important;
            border-radius: 0 !important;
            display: block;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }

        #menu ul ul li a:hover,
        #menu .dropdown-menu .dropdown-item:hover {
            background: #FF2D8D !important;
            color: #fff !important;
        }

        /* ══════════════════════════════
           CONTENT AREA
        ══════════════════════════════ */
        #content {
            margin-top: 116px;
            width: 100%;
            transition: margin-left 0.3s ease;
        }

        /* ══════════════════════════════
           SIDEBAR (kept for compatibility)
        ══════════════════════════════ */
        #sidebar {
            position: fixed;
            top: 116px; left: 0;
            width: 0; height: 100vh;
            background-color: #0B1F66;
            color: #fff;
            overflow-x: hidden; overflow-y: auto;
            z-index: 999;
            transition: width 0.3s ease;
        }

        #sidebar a { color: #fff; text-decoration: none; display: block; padding: 0.5rem 1rem; }
        #sidebar a:hover { background-color: rgba(255,45,141,0.2); }
        #sidebar ul { padding: 0; list-style: none; margin: 0; }
        #sidebar ul li { padding: 0; }
        #sidebar .submenu { display: none; padding-left: 1rem; }

        .sidebar-open #sidebar { width: 30%; }
        .sidebar-open #content { margin-left: 30%; }

        .submenu-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; }
        .fas.fa-caret-down { transition: transform 0.3s ease; font-size: 1rem; }
        .rotate { transform: rotate(180deg); }

        #menu-bar { padding-top: 6rem; position: fixed; left: 1rem; z-index: 1000; }

        /* ══════════════════════════════
           FOOTER
        ══════════════════════════════ */
        .bit-footer {
            background: linear-gradient(90deg, #0B1F66, #081547);
            color: rgba(255,255,255,0.6);
            text-align: center;
            padding: 20px;
            font-size: 12px;
            letter-spacing: 0.5px;
            margin-top: 3rem;
            border-top: 2px solid #FF2D8D;
        }

        /* ══════════════════════════════
           RESPONSIVE
        ══════════════════════════════ */
        @media (max-width: 768px) {
            .top-navbar-title { display: none; }

            #menu { flex-wrap: wrap; height: auto; padding: 8px 1rem; }

            #menu .collapse.navbar-collapse {
                background: #081547;
                border-radius: 0 0 10px 10px;
                padding: 8px 0; width: 100%;
            }

        /* Expanded menu */
        #menu.expanded {
            transition: height 0.3s ease;
            padding-bottom: 220px;
        }
    </style>
    <title>MBA ADMIN</title>
</head>
<body>
    <form id="form2" runat="server" enctype="multipart/form-data">

        <!-- ── TOP NAVBAR ── -->
        <nav class="top-navbar">
            <div class="top-navbar-logo">
                <a href="../../Default.aspx">
                    <img src="logo/logo.png" alt="Logo">
                </a>
            </div>
            <!-- Title Section -->
            <div class="d-none d-sm-flex align-items-center justify-content-center" style="flex: 1;">
                <h3 style="font-size: 1.5rem; font-weight: bold; color: #002366; margin: 0;">Texas Learning System</h3>
            </div>
            <!-- Logout Button Section -->
            <div class="d-flex align-items-center" style="flex: 1; justify-content: flex-end;">
                <asp:LinkButton ID="Linklogin" runat="server" class="btn btn-primary btn-lg active" role="button" aria-pressed="true" OnClick="Linklogout_Click">Logout</asp:LinkButton>

            </div>
        </nav>

        <!-- ── MENU NAVBAR ── -->
        <div id="menu" class="navbar navbar-expand-md navbar-dark">
            <button class="navbar-toggler" type="button"
                data-toggle="collapse" data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Menu Items -->
            <div class="collapse navbar-collapse bg-black" id="navbarSupportedContent">
                <asp:Menu ID="Menu1" runat="server" Orientation="horizontal" CssClass="navbar-nav mr-auto" StaticMenuStyle-CssClass="nav-item"
                    StaticSelectedStyle-CssClass="nav-item" DynamicMenuStyle-CssClass="nav-item dropdown-menu" RenderingMode="List" role="menu" itemscope="itemscope"
                    Font-Bold="True" Font-Names="Corbel Light" Font-Size="Medium" ForeColor="White" StaticEnableDefaultPopOutImage="false">

                    <DynamicMenuStyle CssClass="nav-item dropdown-menu" VerticalPadding="0px"></DynamicMenuStyle>
                    <DynamicSelectedStyle BackColor="#666666" />
                    <Items>
                        <asp:MenuItem Text="Dashboard" Value="Dashboard" NavigateUrl="~/Mba_Admin/dash.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="1st Semester" Value="1st Semester">
                            <asp:MenuItem Text="Business Accounting & Finance" Value="Business Accounting & Finance" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=ACC"></asp:MenuItem>
                            <asp:MenuItem Text="Business Economics" Value="Business Economics" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=ECO"></asp:MenuItem>
                            <asp:MenuItem Text="Human Resource Management" Value="Human Resource Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=HRM"></asp:MenuItem>
                            <asp:MenuItem Text="Managerial Communications" Value="Managerial Communications" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=MC"></asp:MenuItem>
                            <asp:MenuItem Text="Business Environment Analysis" Value="Business Environment Analysis" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=BEA"></asp:MenuItem>
                        </asp:MenuItem>

                        <asp:MenuItem Text="2nd Semester" Value="2nd Semester">
                            <asp:MenuItem Text="Research Methodology" Value="Research Methodology" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=RM"></asp:MenuItem>
                            <asp:MenuItem Text="Operation Management" Value="Operation Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=OM"></asp:MenuItem>
                            <asp:MenuItem Text="Marketing Management" Value="Marketing Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=MM"></asp:MenuItem>
                            <asp:MenuItem Text="Organizational Behavior" Value="Organizational Behavior" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=OB"></asp:MenuItem>
                        </asp:MenuItem>

                        <asp:MenuItem Text="3rd Semester" Value="3rd Semester">
                            <asp:MenuItem Text="Strategic Management" Value="Strategic Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=SM"></asp:MenuItem>
                            <asp:MenuItem Text="Financial Management" Value="Financial Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=FM"></asp:MenuItem>
                            <asp:MenuItem Text="Entrepreneurship Management" Value="Entrepreneurship Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=EM"></asp:MenuItem>
                            <asp:MenuItem Text="Sales & Promotions Management" Value="Sales & Promotions Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=SPM"></asp:MenuItem>
                            <asp:MenuItem Text="International Business" Value="International Business" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=IB"></asp:MenuItem>
                            <asp:MenuItem Text="Human Resource Development & Leadership" Value="Human Resource Development & Leadership" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=HRD"></asp:MenuItem>
                        </asp:MenuItem>

                        <asp:MenuItem Text="4th Semester" Value="4th Semester">
                            <asp:MenuItem Text="Banking & Insurance" Value="Banking & Insurance" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=BI"></asp:MenuItem>
                            <asp:MenuItem Text="Customer Relationship Management" Value="Customer Relationship Management" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=CRM"></asp:MenuItem>
                            <asp:MenuItem Text="Conflict Management & Negotiation Skills" Value="Conflict Management & Negotiation Skills" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=CMN"></asp:MenuItem>
                            <asp:MenuItem Text="Management of Data" Value="Management of Data" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=MOD"></asp:MenuItem>
                            <asp:MenuItem Text="Business Ethics & Governance" Value="Business Ethics & Governance" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=BEG"></asp:MenuItem>
                            <asp:MenuItem Text="Graduate Research Project Paper" Value="Graduate Research Project Paper" NavigateUrl="~/Mba_Admin/course_content.aspx?subject=GRP"></asp:MenuItem>
                        </asp:MenuItem>


                    </Items>

                    <LevelMenuItemStyles>
                        <asp:MenuItemStyle CssClass="dropdown-item" HorizontalPadding="15px" Height="50px" VerticalPadding="15px" />
                    </LevelMenuItemStyles>
                    <LevelSelectedStyles>
                        <asp:MenuItemStyle CssClass="nav-item active" Font-Underline="False" />
                    </LevelSelectedStyles>
                    <StaticHoverStyle Font-Underline="true" ForeColor="#f21f82" BackColor="#002366" Font-Bold="True" Font-Size="Large" />

                    <StaticMenuStyle CssClass="nav-item"></StaticMenuStyle>

                    <StaticSelectedStyle Font-Bold="true" />
                    <DynamicHoverStyle BackColor="#F21F82" />
                    <DynamicMenuItemStyle CssClass="dropdown-item" BackColor="#002366" BorderStyle="None" />
                </asp:Menu>
            </div>
        </div>

        <!-- ── CONTENT ── -->
        <div class="d-flex justify-content-center align-items-center">
            <div id="content" style="margin-top: 116px; width: 100%;">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
        <div class="container-fluid mt-5" style="text-align: center; height: 100px; color: white; background-color: #002366">
            Copyright @ texas lerning portal- 2021/22 
        </div>

        <script>
document.addEventListener('DOMContentLoaded', function () {
    var navbarToggler = document.querySelector('.navbar-toggler');
    var navbar = document.getElementById('menu');
    var collapse = document.querySelector('#navbarSupportedContent');

    navbarToggler.addEventListener('click', function () {
        if (collapse.classList.contains('show')) {
            navbar.classList.remove('expanded');
        } else {
            navbar.classList.add('expanded');
        }
    });
});
</script>
    </form>
</body>
</html>
