            </div>

            <!-- Menu Bar -->
            <div id="menu-bar">
                <button type="button" onclick="toggleSidebar()" class="btn">
                    <i class="fa fa-arrow-right" aria-hidden="true" style="color: black;" id="icon"></i>
                </button>
            </div>

            <!-- Content Area -->
            <div id="content" style="padding-top: 1%; width: 90%; margin-left: 5%;">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
