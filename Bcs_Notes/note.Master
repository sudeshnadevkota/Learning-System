<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="note.master.cs" Inherits="Learning_System.Bcs_Notes.note" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" />
    <link href="mcsdash.css" rel="stylesheet" />

    <style>
        /* ── Google Font ── */
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');

        /* ══ SIDEBAR ══ */
        #sidebar {
            position: fixed;
            top: 5rem;
            left: 0;
            width: 0;
            height: calc(100vh - 5rem);
            background-color: #12183a;
            color: #fff;
            overflow-x: hidden;
            overflow-y: auto;
            z-index: 999;
            transition: width 0.3s ease;
            font-family: 'DM Sans', sans-serif;
            border-right: 1px solid rgba(255,255,255,0.07);
        }

        #sidebar::-webkit-scrollbar { width: 4px; }
        #sidebar::-webkit-scrollbar-track { background: transparent; }
        #sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 4px; }

        #sidebar::before {
            content: "SEMESTERS";
            display: block;
            font-family: 'Sora', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.35);
            padding: 18px 20px 10px;
            white-space: nowrap;
        }

        #sidebar ul {
            padding: 0;
            list-style: none;
            margin: 0;
        }

        /* Semester top-level link */
        #sidebar > ul > li > a {
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 11px 16px;
            font-family: 'Sora', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            border-left: 3px solid transparent;
            transition: background 0.2s, border-color 0.2s, color 0.2s;
            gap: 10px;
            white-space: nowrap;
        }

        #sidebar > ul > li > a:hover {
            background: rgba(255,255,255,0.06);
            color: #fff;
        }

        #sidebar > ul > li.active-sem > a {
            border-left-color: #FF2D8D;
            background: rgba(255,45,141,0.10);
            color: #fff;
        }

        .submenu-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 8px;
        }

        .fas.fa-caret-down {
            transition: transform 0.3s ease;
            font-size: 11px;
            opacity: 0.5;
            margin-left: auto;
        }

        .rotate { transform: rotate(180deg); }

        /* Submenu */
        #sidebar .submenu {
            display: none;
            padding: 4px 0 8px 0;
            background: rgba(0,0,0,0.15);
        }

        #sidebar .submenu ul li a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 16px 7px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 400;
            transition: color 0.2s, background 0.2s;
            white-space: nowrap;
            position: relative;
        }

        #sidebar .submenu ul li a::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            flex-shrink: 0;
        }

        #sidebar .submenu ul li a:hover {
            color: rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.04);
        }

        #sidebar .submenu ul li a:hover::before {
            background: rgba(255,255,255,0.6);
        }

        #sidebar .submenu ul li.active-subject > a {
            color: #FF2D8D;
            font-weight: 500;
        }

        #sidebar .submenu ul li.active-subject > a::before {
            background: #FF2D8D;
        }

        /* Content */
        #content {
            margin-top: 5rem;
            margin-left: 0;
            width: 100%;
            transition: margin-left 0.3s ease;
        }

        .sidebar-open #sidebar { width: 260px; }
        .sidebar-open #content { margin-left: 260px; width: calc(100% - 260px); }

        /* Menu Bar */
        #menu-bar {
            padding-top: 6rem;
            position: fixed;
            left: 10rem;
            z-index: 1000;
        }

        #menu-bar button {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
            border-radius: 8px;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #menu-bar button:hover {
            background: rgba(255,255,255,0.15) !important;
        }

        #icon { color: #fff !important; font-size: 13px; }

        /* Responsive */
        @media (max-width: 900px) {
            .sidebar-open #sidebar {
                width: 260px;
                box-shadow: 4px 0 24px rgba(0,0,0,0.4);
            }
            .sidebar-open #content {
                margin-left: 0 !important;
                width: 100% !important;
            }
            #sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 998;
            }
            .sidebar-open #sidebar-overlay { display: block; }
            #content { padding-left: 0.75rem; padding-right: 0.75rem; }
            #menu-bar { left: 0.5rem; padding-top: 5.6rem; }
        }

        @media (max-width: 576px) {
            .sidebar-open #sidebar { width: 240px; }
            #menu-bar { left: 0.3rem; }
        }
    </style>

    <title>BCS Notes</title>
</head>
<body>
    <form id="form2" runat="server">
