                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'second')">
                            <span class="submenu-toggle">Second Sem <i class="fas fa-caret-down second"></i></span>
                        </a>
                        <div id="second-submenu" class="submenu">
                            <ul>
                                <li><a href="security_in_computing.aspx">Computetrr Ethics</a></li>
                                <li><a href="advance_computer_network.aspx">Data Communication & Networking</a></li>
                                <li><a href="system_analysis_and_design.aspx">Object Oriented Programming</a></li>
                                <li><a href="Python.aspx">Computer Organization</a></li>
                                <li><a href="operating_system.aspx">Operating System</a></li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'third')">
                            <span class="submenu-toggle">Third Sem <i class="fas fa-caret-down third"></i></span>
                        </a>
                        <div id="third-submenu" class="submenu">
                            <ul>
                                <li><a href="digital_logic.aspx">Software Engineering Fundamentals</a></li>
                                <li><a href="windows_server_2016.aspx">Human Computer Interaction</a></li>
                                <li><a href="cyber_security_law_and_policy.aspx">Applied Statistics</a></li>
                                <li><a href="e_commerce.aspx">Microsoft Windows Server Administration</a></li>
                                <li><a href="system_analysis_and_design.aspx">Cyber Security Leagal Issues & Policy Analysis</a></li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fourth')">
                            <span class="submenu-toggle">Fourth Sem <i class="fas fa-caret-down fourth"></i></span>
                        </a>
                        <div id="fourth-submenu" class="submenu">
                            <ul>
                                <li><a href="web_designing.aspx">Web Designing</a></li>
                                <li><a href="Technopreneurship.aspx">Technopreneurship.aspx</a></li>
                                <li><a href="wireless_communications.aspx">Wireless Communications</a></li>
                                <li><a href="ethical_hacking.aspx">Ethical Hacking</a></li>
                                <li><a href="database_management_system.aspx">DMS</a></li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fifth')">
                            <span class="submenu-toggle">Fifth Sem <i class="fas fa-caret-down fifth"></i></span>
                        </a>
                        <div id="fifth-submenu" class="submenu">
                            <ul>
                                <li><a href="AI.aspx">AI</a></li>
