                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fifth')">
                            <span class="submenu-toggle">Fifth Sem <i class="fas fa-caret-down fifth"></i></span>
                        </a>
                        <div id="fifth-submenu" class="submenu">
                            <ul>
                                <li><a href="AI.aspx">AI</a></li>
