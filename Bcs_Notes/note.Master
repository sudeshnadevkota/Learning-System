            </div>
            <div class="d-none d-md-flex align-items-center" style="flex: 1; justify-content: flex-end;"></div>
        </nav>

        <div class="d-flex">
            <div id="sidebar">
                <ul>
                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'first')">
