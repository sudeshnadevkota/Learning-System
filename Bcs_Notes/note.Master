                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'seventh')">
                            <span class="submenu-toggle">Seventh Sem <i class="fas fa-caret-down seventh"></i></span>
                        </a>
                        <div id="seventh-submenu" class="submenu">
                            <ul>
                                <li><a href="system_software_and_administration.aspx">SS & A</a></li>
