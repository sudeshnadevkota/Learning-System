    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var content = document.getElementById('content');
            var menuBar = document.getElementById('menu-bar');
            var sidebarOpen = document.body.classList.toggle('sidebar-open');
            var icon = document.getElementById('icon');

            if (sidebarOpen) {
                sidebar.style.width = '20%'; // Adjust to desired width

                content.style.marginLeft = '20%'; // Adjust to match sidebar width
                content.style.width = '80%'; // Adjust content width accordingly
                menuBar.style.left = '20%'; // Align menu bar with sidebar
                menuBar.style.paddingTop = '-0.7rem'; // Adjust padding
                icon.style.transform = 'rotate(180deg)'; // Rotate icon when sidebar is open
            } else {
                sidebar.style.width = '0'; // Collapse sidebar
                content.style.marginLeft = '0'; // Adjust content margin
                content.style.width = '100%'; // Full width for content
                menuBar.style.left = '3%'; // Align menu bar when sidebar is closed
                icon.style.transform = 'rotate(0deg)'; // Reset icon rotation
            }
        }


        function toggleSubmenu(event, submenuId) {
            event.preventDefault();

            // Get submenu and icon elements
            var submenu = document.getElementById(submenuId + '-submenu');
            var icon = document.querySelector('.' + submenuId);

            // Ensure sidebar is open
            document.body.classList.add('sidebar-open');

            // Toggle the submenu visibility
            if (submenu.style.display === 'block') {
                submenu.style.display = 'none'; // Hide submenu
                icon.classList.remove('rotate'); // Reset icon rotation
            } else {
                submenu.style.display = 'block'; // Show submenu
                icon.classList.add('rotate'); // Rotate icon
            }
        }


        window.onload = function () {
            var sidebar = document.getElementById('sidebar');
            var content = document.getElementById('content');
            var menuBar = document.getElementById('menu-bar');
            var icon = document.getElementById('icon');

            // Open sidebar by default
            document.body.classList.add('sidebar-open');
            sidebar.style.width = '20%'; // Adjust to desired width
            content.style.marginLeft = '20%'; // Adjust to match sidebar width
            content.style.width = '80%'; // Adjust content width accordingly
            menuBar.style.left = '20%'; // Align menu bar with sidebar
            menuBar.style.paddingTop = '-0.7rem'; // Adjust padding
            icon.style.transform = 'rotate(180deg)'; // Rotate icon when sidebar is open
        }


    </script>
