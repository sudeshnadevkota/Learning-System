            </div>

            <div id="content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <script>
/** @returns {boolean} */
function isMobile() {
    return typeof window !== 'undefined' && window.innerWidth <= 900;
}

/** @returns {void} */
function toggleSidebar() {
    if (document.body) {
        document.body.classList.toggle('sidebar-open');
    }
}

/** @returns {void} */
function closeSidebarOverlay() {
    if (document.body) {
        document.body.classList.remove('sidebar-open');
    }
}

/** * @param {Event} event 
 * @param {string} submenuId 
 */
function toggleSubmenu(event, submenuId) {
    if (event && typeof event.preventDefault === 'function') {
        event.preventDefault();
    }

    var submenu = document.getElementById(submenuId + '-submenu');
    if (!submenu) return;

    var parentLi = submenu.parentElement;
    if (!parentLi) return;

    var caretIcon = parentLi.querySelector('.fas.fa-caret-down');

    if (isMobile() && document.body) {
        document.body.classList.add('sidebar-open');
    }

    // Accordion: Shut alternative expanded items securely
    var allItems = document.querySelectorAll('#sidebar > ul > li');
    allItems.forEach(function (item) {
        var li = item;
        if (li !== parentLi) {
            li.classList.remove('active-sem');
            var otherSubmenu = li.querySelector('.submenu');
            var otherIcon = li.querySelector('.fas.fa-caret-down');

            if (otherSubmenu instanceof HTMLElement) {
                otherSubmenu.style.display = 'none';
            }
            if (otherIcon) {
                otherIcon.classList.remove('rotate');
            }
        }
    });

    // Toggle selected panel target display definitions securely
    if (submenu instanceof HTMLElement) {
        if (submenu.style.display === 'block') {
            submenu.style.display = 'none';
            parentLi.classList.remove('active-sem');
            if (caretIcon) caretIcon.classList.remove('rotate');
        } else {
            submenu.style.display = 'block';
            parentLi.classList.add('active-sem');
            if (caretIcon) caretIcon.classList.add('rotate');
        }
    }
}

// Initialize active tracking states on DOM completion
window.addEventListener('DOMContentLoaded', function () {
    if (!isMobile() && document.body) {
        document.body.classList.add('sidebar-open');
    }

    var currentPath = window.location.pathname.split('/').pop();
    if (!currentPath) return;

    var currentPage = currentPath.toLowerCase();
    if (currentPage === "" || currentPage === "default.aspx") {
        return;
    }

    var links = document.querySelectorAll('#sidebar .submenu ul li a');

    links.forEach(function (element) {
        var link = element;
        var linkHref = link.getAttribute('href');
        if (!linkHref) return;

        if (linkHref.toLowerCase() === currentPage) {
            var parentLi = link.parentElement;
            if (parentLi) {
                parentLi.classList.add('active-subject');
            }

            var parentSubmenu = link.closest('.submenu');
            if (parentSubmenu instanceof HTMLElement) {
                parentSubmenu.style.display = 'block';

                var topLi = parentSubmenu.parentElement;
                if (topLi) {
                    topLi.classList.add('active-sem');
                    var caret = topLi.querySelector('.fas.fa-caret-down');
                    if (caret instanceof HTMLElement) {
                        caret.classList.add('rotate');
                    }
                }
            }
        }
    });
});
</script>
</body>
</html>