<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="administrator_master.master.cs" 
    Inherits="Learning_System.administrator.administrator_master" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Administrator Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #0B1F66;
            --secondary: #081547;
            --pink: #FF2D8D;
            --baby-pink: #FF69B4;
        }

        body {
            margin: 0;
            background: #f8fafd;
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        /* TOPBAR */
        .topbar {
            height: 72px;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-img {
            width: 65px;
        }

        .welcome-text {
            font-size: 16px;
            font-weight: 600;
        }

        /* SIDEBAR (DESKTOP) */
        .sidebar {
            background: #0f1f4d;
            min-height: calc(100vh - 72px);
            padding: 20px 14px;
            color: #d1d5db;
        }

        .sidebar .nav-link {
            color: #d1d5db;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 6px;
            transition: 0.3s;
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .sidebar .nav-link:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
            transform: translateX(4px);
        }

        .sidebar .nav-link.active {
            background: var(--primary);
            color: #fff !important;
        }

        /* MAIN CONTENT */
        .main-content {
            padding: 24px;
            min-height: calc(100vh - 72px);
        }

        .btn-baby-pink {
            background: var(--baby-pink);
            color: #fff;
            border: none;
        }

        .btn-baby-pink:hover {
            background: #ff4da3;
        }

        .footer {
            text-align: center;
            padding: 14px;
            background: white;
            border-top: 1px solid #eee;
            font-size: 13px;
        }

        /* ================= MOBILE ================= */

        /* Hide sidebar on mobile */
        @media (max-width: 991px) {
            .sidebar-desktop {
                display: none;
            }

            .main-content {
                padding: 18px;
            }
        }

        @media (max-width: 576px) {
            .welcome-text {
                font-size: 14px;
            }

            .logo-img {
                width: 55px;
            }
        }

        /* Offcanvas sidebar style */
        .offcanvas {
            background: #0f1f4d;
            color: #fff;
        }

        .offcanvas .nav-link {
            color: #d1d5db;
            padding: 12px;
            border-radius: 10px;
        }

        .offcanvas .nav-link:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

        .hamburger {
            font-size: 26px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<form id="form1" runat="server">

<!-- ================= TOPBAR ================= -->
<div class="container-fluid topbar">
    <div class="row align-items-center h-100 px-2">

        <!-- MOBILE MENU BUTTON -->
        <div class="col-2 d-lg-none">
            <i class="bi bi-list hamburger" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar"></i>
        </div>

        <!-- LOGO -->
        <div class="col-lg-2 col-4">
            <a href="default_administrator.aspx">
                <img src="images/logo.png" class="logo-img" />
            </a>
        </div>

        <!-- WELCOME -->
        <div class="col-lg-7 d-none d-lg-block text-center">
            <asp:DataList ID="username" runat="server">
                <ItemTemplate>
                    <div class="welcome-text">
                        Welcome,
                        <span style="color: var(--primary);">
                            <%# Eval("full_name") %>
                        </span>
                        | SuperAdmin
                    </div>
                </ItemTemplate>
            </asp:DataList>
        </div>

        <!-- LOGOUT -->
        <div class="col-lg-3 col-6 text-end">
            <a href="../logout.aspx" class="btn btn-baby-pink btn-sm px-3">
                <i class="bi bi-box-arrow-right"></i>
                <span class="d-none d-sm-inline">Logout</span>
            </a>
        </div>

    </div>
</div>

<!-- ================= MAIN LAYOUT ================= -->
<div class="container-fluid">
    <div class="row">

        <!-- DESKTOP SIDEBAR -->
        <div class="col-lg-2 sidebar sidebar-desktop">
            <ul class="nav flex-column">

                <li><a href="default_administrator.aspx" class="nav-link active">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a></li>

                <li><a href="access.aspx" class="nav-link">
                    <i class="bi bi-person-lock"></i> Access Control
                </a></li>

                <li><a href="#" class="nav-link">
                    <i class="bi bi-people"></i> Users
                </a></li>

                <li><a href="#" class="nav-link">
                    <i class="bi bi-book"></i> Courses
                </a></li>

                <li><a href="#" class="nav-link">
                    <i class="bi bi-graph-up"></i> Analytics
                </a></li>

                <li><a href="#" class="nav-link">
                    <i class="bi bi-gear"></i> Settings
                </a></li>

            </ul>
        </div>

        <!-- CONTENT -->
        <div class="col-lg-10 col-12 main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </div>
</div>

<!-- ================= MOBILE SIDEBAR (OFFCANVAS) ================= -->
<div class="offcanvas offcanvas-start text-white" tabindex="-1" id="mobileSidebar">

    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <ul class="nav flex-column">

            <li><a href="default_administrator.aspx" class="nav-link">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a></li>

            <li><a href="access.aspx" class="nav-link">
                <i class="bi bi-person-lock"></i> Access Control
            </a></li>

            <li><a href="#" class="nav-link">
                <i class="bi bi-people"></i> Users
            </a></li>

            <li><a href="#" class="nav-link">
                <i class="bi bi-book"></i> Courses
            </a></li>

            <li><a href="#" class="nav-link">
                <i class="bi bi-graph-up"></i> Analytics
            </a></li>

            <li><a href="#" class="nav-link">
                <i class="bi bi-gear"></i> Settings
            </a></li>

        </ul>
    </div>
</div>

<!-- ================= FOOTER ================= -->
<div class="footer">
    Powered by RAS © 2026 | All Rights Reserved
</div>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>