<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="administrator_master.master.cs" Inherits="Learning_System.administrator.administrator_master" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Administrator Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f4f7fc;
            overflow-x: hidden;
            font-family: 'Segoe UI';
        }

        .topbar {
            height: 70px;
            background: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .sidebar {
            background: #111827;
            min-height: calc(100vh - 70px);
            padding: 20px 15px;
        }

        .sidebar .nav-link {
            color: #d1d5db;
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 8px;
            transition: 0.3s;
            font-size: 15px;
        }

        .sidebar .nav-link:hover {
            background: #1f2937;
            color: white;
        }

        .sidebar .active {
            background: #2563eb;
            color: white !important;
        }

        .main-content {
            padding: 25px;
        }

        .logo-img {
            width: 75px;
        }

        .welcome-text {
            font-size: 18px;
            font-weight: 600;
        }

        .footer {
            text-align: center;
            padding: 10px;
            background: white;
            color: gray;
            font-size: 14px;
        }

        @media(max-width:768px) {

            .sidebar {
                min-height: auto;
            }

            .topbar {
                height: auto;
                padding: 10px 0;
            }

        }
    </style>

</head>

<body>

    <form id="form1" runat="server">

        <!-- Topbar -->
        <div class="container-fluid topbar">
            <div class="row align-items-center h-100">

                <div class="col-lg-2 col-md-3 col-4 text-center">
                    <a href="default_administrator.aspx">
                        <img src="images/logo.png" class="logo-img" />
                    </a>
                </div>

                <div class="col-lg-8 col-md-6 d-none d-md-block text-center">

                    <asp:DataList ID="username" runat="server" RepeatColumns="1">
                        <ItemTemplate>

                            <div class="welcome-text">
                                Welcome,
                                <span class="text-primary">
                                    <%# Eval("full_name") %>
                                </span>
                                | SuperAdmin
                            </div>

                        </ItemTemplate>
                    </asp:DataList>

                </div>

                <div class="col-lg-2 col-md-3 col-8 text-center">

                    <a href="../logout.aspx" class="btn btn-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>

                </div>

            </div>
        </div>

        <!-- Main Area -->
        <div class="container-fluid">

            <div class="row">

                <!-- Sidebar -->
                <div class="col-lg-2 col-md-3 sidebar">

                    <ul class="nav flex-column">

                        <li class="nav-item">
                            <a href="default_administrator.aspx" class="nav-link active">
                                <i class="bi bi-speedometer2"></i>
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="access.aspx" class="nav-link">
                                <i class="bi bi-person-lock"></i>
                                Access Control
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-people"></i>
                                Users
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-book"></i>
                                Courses
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-graph-up"></i>
                                Analytics
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-gear"></i>
                                Settings
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- Content -->
                <div class="col-lg-10 col-md-9 main-content">

                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>

                </div>

            </div>

        </div>

        <!-- Footer -->
        <div class="footer">
            Powered by RAS © 2026
        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>