<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="administrator_master.master.cs" Inherits="Learning_System.administrator.administrator_master" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Administrator Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f1f5f9;
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        /* TOPBAR */

        .topbar {
            height: 75px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 999;
            padding: 0 20px;
        }

        .logo-img {
            width: 60px;
            transition: 0.3s;
        }

        .logo-img:hover {
            transform: scale(1.05);
        }

        .welcome-box {
            background: #eff6ff;
            padding: 10px 20px;
            border-radius: 14px;
            display: inline-block;
            border: 1px solid #dbeafe;
        }

        .welcome-text {
            font-size: 15px;
            font-weight: 500;
            color: #334155;
        }

        .welcome-text span {
            color: #2563eb;
            font-weight: 700;
        }

        .logout-btn {
            border-radius: 12px;
            padding: 10px 18px;
            font-weight: 500;
            transition: 0.3s;
        }

        .logout-btn:hover {
            transform: translateY(-2px);
        }

        /* SIDEBAR */

        .sidebar {
            background: linear-gradient(180deg, #0f172a, #111827);
            min-height: calc(100vh - 75px);
            padding: 25px 15px;
            position: sticky;
            top: 75px;
        }

        .sidebar-title {
            color: #94a3b8;
            font-size: 13px;
            text-transform: uppercase;
            margin-bottom: 18px;
            letter-spacing: 1px;
            padding-left: 12px;
        }

        .sidebar .nav-link {
            color: #cbd5e1;
            padding: 14px 16px;
            border-radius: 14px;
            margin-bottom: 10px;
            font-size: 15px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar .nav-link i {
            font-size: 18px;
        }

        .sidebar .nav-link:hover {
            background: rgba(255,255,255,0.08);
            color: white;
            transform: translateX(5px);
        }

        .sidebar .active {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: white !important;
            box-shadow: 0 8px 20px rgba(37,99,235,0.3);
        }

        /* MAIN CONTENT */

        .main-content {
            padding: 30px;
            min-height: calc(100vh - 75px);
        }

        .content-card {
            background: white;
            border-radius: 24px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.04);
        }

        /* FOOTER */

        .footer {
            background: white;
            text-align: center;
            padding: 15px;
            font-size: 14px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
        }

        /* MOBILE */

        @media(max-width: 768px) {

            .topbar {
                height: auto;
                padding: 15px 10px;
            }

            .sidebar {
                min-height: auto;
                position: relative;
                top: 0;
            }

            .main-content {
                padding: 18px;
            }

            .welcome-box {
                margin-top: 10px;
            }

            .logout-btn {
                width: 100%;
                margin-top: 10px;
            }
        }
    </style>

</head>

<body>

    <form id="form1" runat="server">

        <!-- TOPBAR -->
        <div class="container-fluid topbar">

            <div class="row align-items-center h-100">

                <!-- LOGO -->
                <div class="col-lg-2 col-md-3 col-4 text-center">
                    <a href="default_administrator.aspx">
                        <img src="images/logo.png" class="logo-img" />
                    </a>
                </div>

                <!-- USER -->
                <div class="col-lg-8 col-md-6 text-center">

                    <asp:DataList ID="username" runat="server" RepeatColumns="1">
                        <ItemTemplate>

                            <div class="welcome-box">
                                <div class="welcome-text">
                                    Welcome Back,
                                    <span>
                                        <%# Eval("full_name") %>
                                    </span>
                                    | Super Admin
                                </div>
                            </div>

                        </ItemTemplate>
                    </asp:DataList>

                </div>

                <!-- LOGOUT -->
                <div class="col-lg-2 col-md-3 col-8 text-center">

                    <a href="../logout.aspx" class="btn btn-danger logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>

                </div>

            </div>

        </div>

        <!-- MAIN -->
        <div class="container-fluid">

            <div class="row">

                <!-- SIDEBAR -->
                <div class="col-lg-2 col-md-3 sidebar">

                    <div class="sidebar-title">
                        Main Navigation
                    </div>

                    <ul class="nav flex-column">

                        <li class="nav-item">
                            <a href="default_administrator.aspx" class="nav-link active">
                                <i class="bi bi-speedometer2"></i>
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="access.aspx" class="nav-link">
                                <i class="bi bi-person-lock"></i>
                                Access Control
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-people"></i>
                                Users
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-book-half"></i>
                                Courses
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-bar-chart-line"></i>
                                Analytics
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="bi bi-gear"></i>
                                Settings
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- CONTENT -->
                <div class="col-lg-10 col-md-9 main-content">

                    <div class="content-card">

                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        </asp:ContentPlaceHolder>

                    </div>

                </div>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="footer">
            Powered by RAS © 2026 | Administrator Panel
        </div>

    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>