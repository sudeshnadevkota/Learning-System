                </ul>
            </div>

            <div id="menu-bar">
                <button type="button" onclick="toggleSidebar()" class="btn">
                    <i class="fa fa-arrow-right" aria-hidden="true" id="icon"></i>
                </button>
            </div>

            <div id="content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <script>
function isMobile() {
    return window.innerWidth <= 900;
}

function toggleSidebar() {
    var sidebar = document.getElementById('sidebar');
    var content = document.getElementById('content');
    var menuBar = document.getElementById('menu-bar');
    var icon = document.getElementById('icon');

    if (!sidebar || !content || !menuBar || !icon) return;

    if (document.body.classList.contains('sidebar-open')) {

        document.body.classList.remove('sidebar-open');

        sidebar.style.width = '0';
        content.style.marginLeft = '0';
        content.style.width = '100%';
        menuBar.style.left = '0.5rem';
        icon.style.transform = 'rotate(0deg)';

    } else {

        document.body.classList.add('sidebar-open');

        sidebar.style.width = '300px';

        if (!isMobile()) {
            content.style.marginLeft = '300px';
            content.style.width = 'calc(100% - 300px)';
            menuBar.style.left = '300px';
        } else {
            content.style.marginLeft = '0';
            content.style.width = '100%';
            menuBar.style.left = '0.5rem';
        }

        icon.style.transform = 'rotate(180deg)';
    }
}

function closeSidebarOverlay() {
    var sidebar = document.getElementById('sidebar');
    var content = document.getElementById('content');
    var icon = document.getElementById('icon');

    document.body.classList.remove('sidebar-open');

    if (sidebar) {
        sidebar.style.width = '0';
    }

    if (content) {
        content.style.marginLeft = '0';
        content.style.width = '100%';
    }

    if (icon) {
        icon.style.transform = 'rotate(0deg)';
    }
}

function toggleSubmenu(event, submenuId) {

    if (event) {
        event.preventDefault();
    }

    var submenu = document.getElementById(submenuId + '-submenu');
    var icon = document.querySelector('.' + submenuId);

    if (!submenu) return;

    var parentLi = submenu.parentElement;

    document.body.classList.add('sidebar-open');

    var items = document.querySelectorAll('#sidebar > ul > li');

    for (var i = 0; i < items.length; i++) {

        var li = items[i];

        if (li !== parentLi) {

            li.classList.remove('active-sem');

            var otherSubmenu = li.querySelector('.submenu');
            var otherIcon = li.querySelector('.fas.fa-caret-down');

            if (otherSubmenu) {
                otherSubmenu.style.display = 'none';
            }

            if (otherIcon) {
                otherIcon.classList.remove('rotate');
            }
        }
    }

    if (submenu.style.display === 'block') {

        submenu.style.display = 'none';

        if (icon) {
            icon.classList.remove('rotate');
        }

        if (parentLi) {
            parentLi.classList.remove('active-sem');
        }

        sessionStorage.removeItem('openSubmenu');

    } else {

        submenu.style.display = 'block';

        if (icon) {
            icon.classList.add('rotate');
        }

        if (parentLi) {
            parentLi.classList.add('active-sem');
        }

        var sidebar = document.getElementById('sidebar');
        var content = document.getElementById('content');
        var menuBar = document.getElementById('menu-bar');
        var mainIcon = document.getElementById('icon');

        if (sidebar) {
            sidebar.style.width = '300px';
        }

        if (content) {
            content.style.marginLeft = '300px';
            content.style.width = 'calc(100% - 300px)';
        }

        if (menuBar) {
            menuBar.style.left = '300px';
        }

        if (mainIcon) {
            mainIcon.style.transform = 'rotate(180deg)';
        }

        // remember which semester panel is open so it survives a real page navigation
        sessionStorage.setItem('openSubmenu', submenuId);
    }
}

function openSubmenuById(submenuId) {

    var submenu = document.getElementById(submenuId + '-submenu');
    var icon = document.querySelector('.' + submenuId);

    if (!submenu) return;

    var parentLi = submenu.parentElement;

    submenu.style.display = 'block';

    if (icon) {
        icon.classList.add('rotate');
    }

    if (parentLi) {
        parentLi.classList.add('active-sem');
    }
}

document.addEventListener('DOMContentLoaded', function () {

    var sidebar = document.getElementById('sidebar');
    var content = document.getElementById('content');
    var menuBar = document.getElementById('menu-bar');
    var icon = document.getElementById('icon');

    if (!isMobile()) {

        // Briefly disable the width/margin transition so applying the open
        // layout below doesn't visibly animate (no blink), while still
        // using inline styles so it's guaranteed to win over any
        // page-specific CSS on the content page.
        document.body.classList.add('no-transition');
        document.body.classList.add('sidebar-open');

        if (sidebar) {
            sidebar.style.width = '300px';
        }

        if (content) {
            content.style.marginLeft = '300px';
            content.style.width = 'calc(100% - 300px)';
        }

        if (menuBar) {
            menuBar.style.left = '300px';
        }

        if (icon) {
            icon.style.transform = 'rotate(180deg)';
        }

        // Re-enable transitions on the next frame so manual toggling
        // (the arrow button, submenu clicks) still animates normally.
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                document.body.classList.remove('no-transition');
            });
        });

    } else {
        if (menuBar) {
            menuBar.style.left = '0.5rem';
        }
    }

    // ── Match the current page (path + query string) against sidebar links ──
    var links = document.querySelectorAll('#sidebar .submenu ul li a');

    var currentUrl = new URL(window.location.href);
    var currentFull = (currentUrl.pathname + currentUrl.search).toLowerCase();

    var matchedSubmenuId = null;

    for (var j = 0; j < links.length; j++) {

        var link = links[j];
        var hrefAttr = link.getAttribute('href');

        if (!hrefAttr) continue;

        var linkUrl = new URL(hrefAttr, window.location.origin);
        var linkFull = (linkUrl.pathname + linkUrl.search).toLowerCase();

        if (linkFull === currentFull) {

            if (link.parentElement) {
                link.parentElement.classList.add('active-subject');
            }

            var parentSubmenu = link.parentElement;

            while (parentSubmenu &&
                !parentSubmenu.classList.contains('submenu')) {
                parentSubmenu = parentSubmenu.parentElement;
            }

            if (parentSubmenu) {

                parentSubmenu.style.display = 'block';

                var parentLi = parentSubmenu.parentElement;

                if (parentLi) {

                    parentLi.classList.add('active-sem');

                    var caret = parentLi.querySelector('.fas.fa-caret-down');

                    if (caret) {
                        caret.classList.add('rotate');
                    }

                    matchedSubmenuId = parentSubmenu.id.replace('-submenu', '');
                }
            }
        }
    }

    // remember whichever submenu is now open (from URL match)
    if (matchedSubmenuId) {
        sessionStorage.setItem('openSubmenu', matchedSubmenuId);
    } else {
        // fall back to whatever the user last opened manually
        var savedSubmenu = sessionStorage.getItem('openSubmenu');
        if (savedSubmenu) {
            openSubmenuById(savedSubmenu);
        }
    }
});
</script>
</body>
</html>
