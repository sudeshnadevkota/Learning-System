                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fourth')">
                            <span class="submenu-toggle">Fourth Sem <i class="fas fa-caret-down fourth"></i></span>
                        </a>
                        <div id="fourth-submenu" class="submenu">
                            <ul>
                                <li><a href="business_law.aspx">Business Law</a></li>
                                <li><a href="project_management.aspx">PM</a></li>
                                <li><a href="introduction_to_financial_accounting.aspx">Intro To FA</a></li>
                                <li><a href="company_law.aspx">Company Law</a></li>
                                <li><a href="psychology.aspx">Psychology</a></li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fifth')">
                            <span class="submenu-toggle">Fifth Sem <i class="fas fa-caret-down fifth"></i></span>
                        </a>
                        <div id="fifth-submenu" class="submenu">
                            <ul>
                                <li><a href="international_business_management.aspx">Intl BM</a></li>
                                <li><a href="marketing_management.aspx">Marketing Mgmt</a></li>
