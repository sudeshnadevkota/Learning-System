                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'eighth')">
                            <span class="submenu-toggle">Eighth Sem <i class="fas fa-caret-down eighth"></i></span>
                        </a>
                        <div id="eighth-submenu" class="submenu">
                            <ul>
                                <li><a href="industrial_training.aspx">Industry Training</a></li>
                            </ul>
