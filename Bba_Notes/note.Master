            </div>
        </nav>

        <div class="d-flex">
            <div id="sidebar">
                <ul>
                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'first')">
                            <span class="submenu-toggle">First Sem <i class="fas fa-caret-down first"></i></span>
                        </a>
                        <div id="first-submenu" class="submenu">
                            <ul>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_ENG_I">English I</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_EPP">English for Professional Purposes</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_POM">Principles of Management</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_IA">Introduction to Accounting</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_FCPP">Fundamental Computer Principles & Programming</a></li>
