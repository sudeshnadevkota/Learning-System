                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'second')">
                            <span class="submenu-toggle">Second Sem <i class="fas fa-caret-down second"></i></span>
                        </a>
                        <div id="second-submenu" class="submenu">
                            <ul>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_HRM">Human Resource Management</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_POF">Principles of Marketing</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_IFA">Internet Fundamentals & Applications</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_E">Entrepreneurship</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_ENG_II">English II</a></li>
                          </ul>
                        </div>
