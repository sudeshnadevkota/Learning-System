                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'sixth')">
                            <span class="submenu-toggle">Sixth Sem <i class="fas fa-caret-down sixth"></i></span>
                        </a>
                        <div id="sixth-submenu" class="submenu">
                            <ul>
                                <li><a href="e_commerce.aspx">E-Commerce</a></li>
                                <li><a href="organizational_behavior.aspx">Org Behavior</a></li>
                                <li><a href="consumer_behavior.aspx">Con Behavior</a></li>
