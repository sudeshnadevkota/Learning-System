                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'third')">
                            <span class="submenu-toggle">Third Sem <i class="fas fa-caret-down third"></i></span>
                        </a>
                        <div id="third-submenu" class="submenu">
                            <ul>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_S">Sociology</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_BO">Business Organizationa></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_BL">Business Law</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_HRLS">Human Relations and Leadership Skills</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_M">Microeconomics</a></li>
                                <li><a href="/Bba_Notes/course_content.aspx?code=BBA_PM">Project Management</a></li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fourth')">
                            <span class="submenu-toggle">Fourth Sem <i class="fas fa-caret-down fourth"></i></span>
                        </a>
                        <div id="fourth-submenu" class="submenu">
                            <ul>
                                <li><a href="business_law.aspx">Business Law</a></li>
