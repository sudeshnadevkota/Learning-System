                        <asp:MenuItem Text="Financial Management" Value="E-commerce"  NavigateUrl="~/Bba_Admin/financial_management(fin).aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Taxation And Auditing" Value="Taxation And Auditing"  NavigateUrl="~/Bba_Admin/taxation_and_auditing(fin).aspx"></asp:MenuItem>

<asp:MenuItem Text="Bachelor Thesis Finance" Value="Bachelor Thesis Finance" NavigateUrl="~/Bba_Admin/bachelor_thesis_on_internship_fin.aspx"></asp:MenuItem>
                       
                    </asp:MenuItem>

                </Items>

                <LevelMenuItemStyles>
                    <asp:MenuItemStyle CssClass="dropdown-item" HorizontalPadding="15px" Height="50px" VerticalPadding="15px" />
                </LevelMenuItemStyles>
                <LevelSelectedStyles>
                    <asp:MenuItemStyle CssClass="nav-item active" Font-Underline="False" />
                </LevelSelectedStyles>
                <StaticHoverStyle Font-Underline="true" ForeColor="#f21f82" BackColor="#002366" Font-Bold="True" Font-Size="Large" />

<StaticMenuStyle CssClass="nav-item"></StaticMenuStyle>

                <StaticSelectedStyle Font-Bold="true"   />
            <DynamicHoverStyle BackColor="#F21F82" />
            <DynamicMenuItemStyle CssClass="dropdown-item" BackColor="#002366" BorderStyle="None" />
        </asp:Menu>
            </div>
        </div>




        <div class="d-flex justify-content-center align-items-center ">
            <!-- Content Area -->
            <div id="content" style="margin-top: 150px;">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
