<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="note.master.cs" Inherits="Learning_System.Bit_Notes.note" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" />
    <link href="mcsdash.css" rel="stylesheet" />
    <style>
        /* ── Google Font ── */
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap');

        /* ══ SIDEBAR ══ */
        #sidebar {
            position: fixed;
            top: 5rem;
            left: 0;
            width: 0;
            height: calc(100vh - 5rem);
            background-color: #12183a;
            color: #fff;
            overflow-x: hidden;
            overflow-y: auto;
            z-index: 999;
            transition: width 0.3s ease;
            font-family: 'DM Sans', sans-serif;
            border-right: 1px solid rgba(255,255,255,0.07);
        }

        /* Scrollbar */
        #sidebar::-webkit-scrollbar { width: 4px; }
        #sidebar::-webkit-scrollbar-track { background: transparent; }
        #sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 4px; }

        /* ── SEMESTERS label at top ── */
        #sidebar::before {
            content: "SEMESTERS";
            display: block;
            font-family: 'Sora', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.35);
            padding: 18px 20px 10px;
        }

        #sidebar ul {
            padding: 0;
            list-style: none;
            margin: 0;
        }

        #sidebar ul li {
            padding: 0;
        }

        /* ── Semester top-level link ── */
        #sidebar > ul > li > a {
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 11px 16px;
            font-family: 'Sora', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            border-left: 3px solid transparent;
            transition: background 0.2s, border-color 0.2s, color 0.2s;
            gap: 10px;
        }

        #sidebar > ul > li > a:hover {
            background: rgba(255,255,255,0.06);
            color: #fff;
        }

        /* Active semester (when submenu is open) */
        #sidebar > ul > li.active-sem > a {
            border-left-color: #FF2D8D;
            background: rgba(255,45,141,0.10);
            color: #fff;
        }

        /* ── Numbered badge ── */
        .sem-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            background: rgba(255,255,255,0.12);
            font-size: 11px;
            font-weight: 700;
            font-family: 'Sora', sans-serif;
            color: rgba(255,255,255,0.7);
            flex-shrink: 0;
            transition: background 0.2s, color 0.2s;
        }

        #sidebar > ul > li.active-sem .sem-badge {
            background: #FF2D8D;
            color: #fff;
        }

        /* ── Chevron icon ── */
        .submenu-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 8px;
        }

        .sem-name { flex: 1; }

        .fas.fa-caret-down {
            transition: transform 0.3s ease;
            font-size: 11px;
            opacity: 0.5;
            margin-left: auto;
        }

        .rotate { transform: rotate(180deg); }

        /* ── Submenu / subjects ── */
        #sidebar .submenu {
            display: none;
            padding: 4px 0 8px 0;
            background: rgba(0,0,0,0.15);
        }

        #sidebar .submenu ul { padding: 0; }

        #sidebar .submenu ul li a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 16px 7px 36px;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 400;
            transition: color 0.2s, background 0.2s;
            position: relative;
        }

        /* dot before each subject */
        #sidebar .submenu ul li a::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            flex-shrink: 0;
            transition: background 0.2s;
        }

        #sidebar .submenu ul li a:hover {
            color: rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.04);
        }

        #sidebar .submenu ul li a:hover::before {
            background: rgba(255,255,255,0.6);
        }

        /* Active subject link */
        #sidebar .submenu ul li.active-subject > a {
            color: #FF2D8D;
            font-weight: 500;
        }

        #sidebar .submenu ul li.active-subject > a::before {
            background: #FF2D8D;
        }

        /* ══ CONTENT ══ */
        #content {
            margin-top: 5rem;
            margin-left: 0;
            width: 100%;
            transition: margin-left 0.3s ease;
        }

        /* ══ OPEN STATE ══ */
        .sidebar-open #sidebar {
            width: 300px;
        }

        .sidebar-open #content {
            margin-left: 300px;
            width: calc(100% - 300px);
        }

        /* ══ MENU BAR TOGGLE BUTTON ══ */
        #menu-bar {
            padding-top: 6rem;
            position: fixed;
            left: 10rem;
            z-index: 1000;
        }

        #menu-bar button {
            background: #e8ecf7 !important;
            border: 1.5px solid #c5cde8 !important;
            border-radius: 8px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            transition: background 0.2s, box-shadow 0.2s;
            box-shadow: 0 2px 8px rgba(8,21,71,0.12);
        }

        #menu-bar button:hover {
            background: #d0d8f0 !important;
            box-shadow: 0 4px 12px rgba(8,21,71,0.18) !important;
        }

        #icon { color: #12183a !important; font-size: 15px; font-weight: 900; }

        /* ══ MEDIA QUERIES ══ */
        @media (max-width: 900px) {
            .sidebar-open #sidebar {
                width: 300px;
                box-shadow: 4px 0 24px rgba(0,0,0,0.4);
            }

            .sidebar-open #content {
                margin-left: 0 !important;
                width: 100% !important;
            }

            #sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 998;
            }
            .sidebar-open #sidebar-overlay {
                display: block;
            }

            #content {
                width: 100% !important;
                margin-left: 0 !important;
                padding-left: 0.75rem;
                padding-right: 0.75rem;
            }

            #menu-bar {
                left: 0.5rem;
                padding-top: 5.6rem;
            }
        }

        @media (max-width: 576px) {
            .sidebar-open #sidebar { width: 240px; }
            #menu-bar { left: 0.3rem; }
        }
    </style>
    <title>BIT notes</title>
</head>
<body>
    <form id="form2" runat="server">
