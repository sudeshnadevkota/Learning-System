                             <li><a href="/Bit_Notes/course_content.aspx?code=OS">Operating System</a></li>


                                

                            </ul>
                        </div>
                    </li>
                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'third')">
                            <span class="submenu-toggle"><span class="sem-badge">3</span><span class="sem-name">Third Sem</span> <i class="fas fa-caret-down third"></i></span>
                        </a>
                        <div id="third-submenu" class="submenu">

                         <ul>
                         <li><a href="/Bit_Notes/course_content.aspx?code=DELD">Digital Electronics and Logic Design</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=DSA">Data Structure &amp; Algorithm</a></li>
