                                <li><a href="/Bit_Notes/course_content.aspx?code=BCA">Basic Computer Architecture</a></li>
                            </ul>
                        </div>
                    </li>

                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'second')">
                            <span class="submenu-toggle"><span class="sem-badge">2</span><span class="sem-name">Second Sem</span> <i class="fas fa-caret-down second"></i></span>
                        </a>
                        <div id="second-submenu" class="submenu">
                            <ul>

                             <li><a href="/Bit_Notes/course_content.aspx?code=HCI">Human Computer Interaction</a></li>
                             <li><a href="/Bit_Notes/course_content.aspx?code=DM">Discrete Mathematics</a></li>
                             <li><a href="/Bit_Notes/course_content.aspx?code=DCN">Data Communication and Networks</a></li>
