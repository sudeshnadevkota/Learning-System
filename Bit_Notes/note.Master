                <button type="button" onclick="toggleSidebar()" class="btn " style="background: none;">
                    <%--                    <i class="fa fa-bars" aria-hidden="true" style="color:black;"></i>--%>
                    <i class="fa fa-arrow-right " aria-hidden="true" style="color: black;" id="icon"></i>

                </button>
