                         <li><a href="/Bit_Notes/course_content.aspx?code=LA">Linux Administration</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=DMS">Database Management System</a></li>


                         <ul>
                         <li><a href="/Bit_Notes/course_content.aspx?code=DELD">Digital Electronics and Logic Design</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=DSA">Data Structure &amp; Algorithm</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=IM">Industrial Management</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=WT">Web Technology</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=LA">Linux Administration</a></li>
                         <li><a href="/Bit_Notes/course_content.aspx?code=DMS">Database Management System</a></li>

                           

                         </ul>
                        </div>
                    </li>
                    <li>
                        <a href="#" onclick="toggleSubmenu(event, 'fourth')">
                            <span class="submenu-toggle"><span class="sem-badge">4</span><span class="sem-name">Fourth Sem</span> <i class="fas fa-caret-down fourth"></i></span>
                        </a>
                        <div id="fourth-submenu" class="submenu">
                            <ul>
                                <li><a href="database_management_system.aspx">DBMS</a></li>
