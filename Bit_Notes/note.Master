    <script>
function isMobile() { return window.innerWidth <= 900; }

function toggleSidebar() {
    var sidebar = document.getElementById('sidebar');
    var content = document.getElementById('content');
    var menuBar = document.getElementById('menu-bar');
    var icon = document.getElementById('icon');

    var sidebarOpen = document.body.classList.toggle('sidebar-open');

    if (sidebarOpen) {
        sidebar.style.width = '260px';
        if (!isMobile()) {
            content.style.marginLeft = '260px';
            content.style.width = 'calc(100% - 260px)';
            menuBar.style.left = '260px';
        } else {
            content.style.marginLeft = '0';
            content.style.width = '100%';
            menuBar.style.left = '0.5rem';
        }
        icon.style.transform = 'rotate(180deg)';
    } else {
        sidebar.style.width = '0';
        content.style.marginLeft = '0';
        content.style.width = '100%';
        menuBar.style.left = '0.5rem';
        icon.style.transform = 'rotate(0deg)';
    }
}

function closeSidebarOverlay() {
    document.body.classList.remove('sidebar-open');
    document.getElementById('sidebar').style.width = '0';
    document.getElementById('content').style.marginLeft = '0';
    document.getElementById('content').style.width = '100%';
    document.getElementById('icon').style.transform = 'rotate(0deg)';
}

function toggleSubmenu(event, submenuId) {
    event.preventDefault();

    var submenu = document.getElementById(submenuId + '-submenu');
    var icon = document.querySelector('.' + submenuId);
    var parentLi = submenu.parentElement;

    document.body.classList.add('sidebar-open');

    // Close other open semesters
    document.querySelectorAll('#sidebar > ul > li').forEach(function (li) {
        if (li !== parentLi) {
            li.classList.remove('active-sem');
            var otherSubmenu = li.querySelector('.submenu');
            var otherIcon = li.querySelector('.fas.fa-caret-down');
            if (otherSubmenu) otherSubmenu.style.display = 'none';
            if (otherIcon) otherIcon.classList.remove('rotate');
        }
    });

    if (submenu.style.display === 'block') {
        submenu.style.display = 'none';
        icon.classList.remove('rotate');
        parentLi.classList.remove('active-sem');
    } else {
        submenu.style.display = 'block';
        icon.classList.add('rotate');
        parentLi.classList.add('active-sem');

        // Update sidebar width in JS too
        var sidebar = document.getElementById('sidebar');
        var content = document.getElementById('content');
        var menuBar = document.getElementById('menu-bar');
        sidebar.style.width = '260px';
        content.style.marginLeft = '260px';
        content.style.width = 'calc(100% - 260px)';
        menuBar.style.left = '260px';
        document.getElementById('icon').style.transform = 'rotate(180deg)';
    }
}

// Mark active subject based on current page URL
window.onload = function () {
    var sidebar = document.getElementById('sidebar');
    var content = document.getElementById('content');
    var menuBar = document.getElementById('menu-bar');
    var icon = document.getElementById('icon');

    // Only auto-open sidebar on desktop
    if (!isMobile()) {
        document.body.classList.add('sidebar-open');
        sidebar.style.width = '260px';
        content.style.marginLeft = '260px';
        content.style.width = 'calc(100% - 260px)';
        menuBar.style.left = '260px';
        icon.style.transform = 'rotate(180deg)';
    } else {
        menuBar.style.left = '0.5rem';
    }

    // Auto-highlight current page in sidebar
    var currentPage = window.location.pathname.split('/').pop().toLowerCase();
    var links = document.querySelectorAll('#sidebar .submenu ul li a');
    links.forEach(function (link) {
        var href = link.getAttribute('href').toLowerCase();
        if (href === currentPage) {
            link.parentElement.classList.add('active-subject');
            // Also open + activate the parent semester
            var parentSubmenu = link.closest('.submenu');
            var parentLi = parentSubmenu.parentElement;
            parentSubmenu.style.display = 'block';
            parentLi.classList.add('active-sem');
            var caret = parentLi.querySelector('.fas.fa-caret-down');
            if (caret) caret.classList.add('rotate');
        }
    });
}
</script>

</body>
</html>