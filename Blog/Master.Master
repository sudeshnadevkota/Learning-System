<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.master.cs" Inherits="Learning_System.Blog.Master" %>


<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Texas College Virtual System</title>
     <link href="style.css" rel="stylesheet" />
    <script src="Scripts/jquery-3.0.0.min.js"></script>
    <script src="Scripts/bootstrap.min.js"></script>

    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js" integrity="sha384-eMNCOe7tC1doHpGoWe/6oMVemdAVTMs2xqW4mwXrXsW0L84Iytr2wi5v2QjrP/xp" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/js/bootstrap.min.js" integrity="sha384-cn7l7gDp0eyniUwwAZgrzD06kc/tftFf19TOAs2zVinnD/C7E91j9yyk5//jjpt/" crossorigin="anonymous"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
       
    <style>
        /* Apply font family to the entire body */
*{
    margin: 0;
    padding: 0;
    box-sizing:border-box;
    
    font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
}
  
        .hover-effect:hover {
            transform: scale(1.05);
            transition: transform 0.3s ease;
        }


           .hover-effect:hover {
       transform: scale(1.05);
       transition: transform 0.3s ease;
   }
   .card-img-top {
       object-fit: cover;
       height: 150px;
       width: 100%;
   }
   .card {
       display: flex;
       flex-direction: column;
       justify-content: space-between;
   }
   

/* Apply to main headings */
h1, h2, h3 {
    font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
}

/* Apply to paragraphs */
p {
    font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
}

/* Apply to list items */
li {
    font-family: "Arial Light", "Arial", "Helvetica", "Calibri", "Tahoma", "Verdana", sans-serif;
}
        :root {
            --bs-primary: #28346f;
            --bs-primary-rgb: 40, 52, 111;
        }


        .btn-primary {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }

             .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
  background-color: #1e2754;
  border-color: #1e2754;
} 

            .btn-primary:hover,
            .btn-primary:focus,
            .btn-primary:active {
                background-color: #0b0b0b;
                border-color: #1e2754;
            }

        .bg-primary {
            background-color: var(--bs-primary) !important;
        }

        .text-primary {
            color: var(--bs-primary) !important;
        }

        .navbar-nav {
            margin: auto;
        }

            .navbar-nav li {
                margin-left: 15px;
                margin-right: 15px;
            }

        @media (max-width: 767.98px) {
            .offcanvas-body {
                margin-top: 1rem !important;
            }
        }


    .hover-effect {
        position: relative;
        transition: transform 0.3s ease-in-out;
    }

    .hover-effect:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .social-links {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }

    .hover-effect:hover .social-links {
        opacity: 1;
    }

    .card-body {
        position: relative;
        padding-bottom: 50px; /* Add some padding to ensure space for the social links */
    }


      .instructor-card {
      position: relative;
      overflow: hidden;
      margin-bottom: 20px;
  }

      .instructor-card img {
          width: 100%;
          height: 300px;
          object-fit:cover;
      }

  .social-icons {
      position: absolute;
      right: -40px;
      top: 70px;
      transition: right 0.3s ease;
  }

  .instructor-card:hover .social-icons {
      right: 10px;
  }

  .social-icons a {
      display: block;
      
      margin-bottom: 10px;
      background: white;
      padding: 5px;
      border-radius: 50%;
      text-align: center;
      width: 30px;
      height: 30px;
      background:#28346f;
      color:white;
  }

  .instructor-name {
      font-weight: bold;
      margin-top: 10px;
      margin-bottom: 0;
  }

  .instructor-role {
      color: #888;
      font-size: 0.9em;
  }

  .custom-hover:hover {
    text-decoration: underline;
    color: #28346f;
    transition: color 0.3s ease-in-out;
}

.custom-hover a:hover {
    color: #28346f !important;
}


 .instructor-card {
     position: relative;
     overflow: hidden;
     margin-bottom: 20px;
 }

     .instructor-card img {
         width: 100%;
         height: 300px;
         object-fit:cover;
     }

 .social-icons {
     position: absolute;
     right: -40px;
     top: 70px;
     transition: right 0.3s ease;
 }

 .instructor-card:hover .social-icons {
     right: 10px;
 }

 .social-icons a {
     display: block;
     
     margin-bottom: 10px;
     background: white;
     padding: 5px;
     border-radius: 50%;
     text-align: center;
     width: 30px;
     height: 30px;
     background:black;
     color:white;
 }

 .instructor-name {
     font-weight: bold;
     margin-top: 10px;
     margin-bottom: 0;
 }

 .instructor-role {
     color: #888;
     font-size: 0.9em;
 }


     .carousel .carousel-item {
         color: #999;
         overflow: hidden;
         min-height: 120px;
         font-size: 13px;
     }

     .carousel .media img {
         width: 80px;
         height: 80px;
         display: block;
         border-radius: 50%;
     }

     .carousel .testimonial {
         padding: 0 15px 0 60px;
         position: relative;
     }

         .carousel .testimonial::before {
             content: "\201C";
             font-family: Arial, sans-serif;
             color: #e2e2e2;
             font-weight: bold;
             font-size: 68px;
             line-height: 54px;
             position: absolute;
             left: 15px;
             top: 0;
         }

     .carousel .overview b {
         text-transform: uppercase;
         color: #1c47e3;
     }

     .carousel-indicators {
         bottom: -40px;
     }

         .carousel-indicators [data-bs-target], .carousel-indicators [data-bs-target].active {
             width: 20px;
             height: 20px;
             border-radius: 50%;
             margin: 1px 3px;
             box-sizing: border-box;
         }

         .carousel-indicators [data-bs-target] {
             background: #e2e2e2;
             border: 4px solid #fff;
         }

             .carousel-indicators [data-bs-target].active {
                 color: #fff;
                 background: #1c47e3;
                 border: 5px double;
             }
  .nima-card {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .button-container {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }
        .nima-card:hover .button-container {
            transform: translateY(0);
        }


    </style>
</head>

<body class="text-primary">

    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager2" runat="server"></asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow  bg-body rounded">
            <div class="container">
                <a class="navbar-brand" href="Default.aspx">
                   

                    <img src="../slide/logo.png" alt="logo" width="150" />

                </a>
                <!-- Toggler Button -->
                <button class="navbar-toggler shadow-none border-0" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>


                <div class="sidebar offcanvas offcanvas-end bg-custom text-light" tabindex="-1" id="offcanvasNavbar"
                    aria-labelledby="offcanvasNavbarLabel">
                    <!-- Sidebar Header -->
                    <div class="offcanvas-header text-white border-bottom">
                        <h5 class="offcanvas-title text-primary" id="offcanvasNavbarLabel">Texas Learning Portal</h5>
                        <button type="button" class="btn-close btn-close-dark shadow-none" data-bs-dismiss="offcanvas"
                            aria-label="Close">
                        </button>
                    </div>

                    <!-- Sidebar Body -->
                    <div class="offcanvas-body d-flex flex-column  flex-lg-row p-4 p-lg-0">
                        <ul
                            class="navbar-nav mx-auto justify-content-center align-items-center flex-grow-1 pe-3  z-3 opacity-100">


                            <li><a href="Default.aspx"  class="text-decoration-none text-primary fs-5">Home</a></li>
                            <li><a href="AboutUs.aspx" class="text-decoration-none text-primary fs-5">About Us</a></li>
                            <li><a href="Contact.aspx" class="text-decoration-none text-primary fs-5">Contact</a></li>
                            <li><a href="dash.aspx" class="text-decoration-none text-primary fs-5">Blog</a></li>
                           
                           

                        </ul>

                        <div class="d-flex flex-column flex-lg-row align-items-center gap-3">

                  

                                    <asp:LinkButton ID="Linklogin" runat="server" class="btn text-primary me-2 fs-5" role="button" aria-pressed="true" OnClick="Linklogin_Click" >Login</asp:LinkButton> 
            <asp:LinkButton ID="Linkregister" runat="server" class="btn btn-primary fs-5" role="button" aria-pressed="true" OnClick="Linkregister_Click" Style="border-radius: 35px;">Register</asp:LinkButton>

                        </div>
                    </div>

                </div>
            </div>
        </nav>


       



        <div class="">
            
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />

        </div>



