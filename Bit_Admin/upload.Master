<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="upload.master.cs" Inherits="Learning_System.Bit_Admin.upload" %>

<!DOCTYPE html>
<html>
<head runat="server">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
     <link rel="stylesheet" href="~/styles/AdminStyles.css" />
  <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #0B1F66;
      --secondary: #081547;
      --pink: #FF2D8D;
      --pink-light: rgba(255,45,141,0.08);
      --gray-bg: #fafbff;
      --border-color: rgba(11,31,102,0.08);
      --text-muted: #6b7280;
      --sidebar-w: 260px;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--gray-bg);
      margin: 0;
    }

    .bit-shell { display: flex; min-height: 100vh; }

    /* ══ SIDEBAR ══ */
    .bit-sidebar {
      width: var(--sidebar-w);
      flex: none;
      background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
      color: #fff;
      display: flex;
      flex-direction: column;
      padding: 20px 14px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    .bit-sidebar::after {
      content: '';
      position: absolute;
      bottom: -10px; left: -20px;
      width: 320px; height: 320px;
      background: url('../slide/logo2.0.png') no-repeat center/contain;
      opacity: 0.35;
      pointer-events: none;
      z-index: 0;
    }

    .bit-sidebar > * { position: relative; z-index: 1; }

    .bit-sidebar-scroll {
      overflow-y: auto;
      overflow-x: hidden;
      flex: 1;
      margin: 0 -14px;
      padding: 0 14px;
      -webkit-overflow-scrolling: touch;
    }

    .bit-sidebar-scroll::-webkit-scrollbar { width: 4px; }
    .bit-sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }

    .bit-brand {
      display: flex; align-items: center; gap: 12px;
      padding: 6px 6px 20px;
    }

    .bit-brand img { width: 40px; height: 40px; object-fit: contain; border-radius: 10px; background: #fff; padding: 4px; }
    .bit-brand-text strong { display: block; font-weight: 800; font-size: 14.5px; letter-spacing: -.2px; }
    .bit-brand-text span { display: block; font-size: 10.5px; color: rgba(255,255,255,.5); }

   
    @keyframes bitpulse { 0%,100% { opacity: 1; } 50% { opacity: .3; } }

    .bit-nav-link {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 10px;
      color: rgba(255,255,255,.75); text-decoration: none;
      font-weight: 600; font-size: 13px;
      transition: background .15s, color .15s;
      margin-bottom: 2px;
      border: none; background-color: transparent; width: 100%; text-align: left;
      font-family: 'Plus Jakarta Sans', sans-serif; cursor: pointer;
    }
    .bit-nav-link i { width: 18px; text-align: center; font-size: 1rem; }
    .bit-nav-link:hover { background: rgba(255,255,255,.08); color: #fff; }
    .bit-nav-link.active { background: rgba(255,45,141,.16); color: #fff; box-shadow: inset 3px 0 0 var(--pink); }

    .bit-eyebrow {
      font-size: 10px; font-weight: 800; letter-spacing: 1.6px;
      color: rgba(255,255,255,.35); text-transform: uppercase;
      padding: 14px 12px 8px;
    }

    /* Semester accordion */
    .sem-item { margin-bottom: 1px; }
    .sem-header {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; border-radius: 9px; cursor: pointer; user-select: none;
      color: rgba(255,255,255,.6); font-size: 13px; font-weight: 500;
      transition: background .15s, color .15s;
    }
    .sem-header:hover { background: rgba(255,255,255,.06); color: rgba(255,255,255,.9); }
    .sem-header.active { background: rgba(30,58,138,.5); color: #fff; }
    .sem-badge {
      width: 19px; height: 19px; border-radius: 6px; background: rgba(255,255,255,.1);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 10.5px; font-weight: 800; flex: none; color: rgba(255,255,255,.65);
    }
    .sem-header.active .sem-badge { background: var(--pink); color: #fff; }
    .sem-name { flex: 1; }
    .sem-chevron { font-size: 10.5px; opacity: .45; transition: transform .25s; }
    .sem-item.open .sem-chevron { transform: rotate(180deg); opacity: 1; color: var(--pink); }

    .sem-submenu { display: none; padding: 2px 0 6px 0; }
    .sem-item.open .sem-submenu { display: block; }

    .sem-submenu a {
      display: flex; align-items: center; gap: 8px;
      padding: 7px 12px 7px 38px; margin-bottom: 1px; border-radius: 8px;
      color: rgba(255,255,255,.5); text-decoration: none; font-size: 12px;
      transition: color .15s, background .15s;
    }
    .sem-submenu a::before {
      content: ''; width: 4px; height: 4px; border-radius: 50%;
      background: rgba(255,255,255,.25); flex: none;
    }
    .sem-submenu a:hover { color: #fff; background: rgba(255,45,141,.12); }
    .sem-submenu a:hover::before { background: rgba(255,255,255,.7); }
    .sem-submenu a.active-link { color: #fff; font-weight: 600; background: rgba(255,45,141,.18); }
    .sem-submenu a.active-link::before { background: var(--pink); }

    .bit-sidebar-foot { padding-top: 12px; }

    .bit-sidebar-user {
      display: flex; align-items: center; gap: 10px; padding: 11px;
      border-radius: 12px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
      margin-bottom: 8px;
    }
    .bit-sidebar-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, var(--pink), #ff5aa5);
      display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 12px; flex: none;
    }
    .bit-sidebar-user-name { font-size: 12.5px; font-weight: 700; line-height: 1.2; }
    .bit-sidebar-user-role { font-size: 10.5px; color: rgba(255,255,255,.5); }

    .bit-logout-btn {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      width: 100%; padding: 10px; border-radius: 10px; border: none;
      background: var(--pink); color: #fff; font-weight: 700; font-size: 12.5px;
      cursor: pointer; text-decoration: none; font-family: 'Plus Jakarta Sans', sans-serif;
      transition: opacity .15s;
    }
    .bit-logout-btn:hover { opacity: .88; color: #fff; }

    /* ══ CONTENT ══ */
    .bit-content { flex: 1; min-width: 0; }

    /* ══ FOOTER ══ */
    .bit-footer {
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      color: rgba(255,255,255,.55);
      text-align: center; padding: 18px; font-size: 11.5px; letter-spacing: .5px;
    }

    /* ══ MOBILE ══ */
    .bit-mobile-topbar { display: none; }

    /* ══ FLOATING MENU TOGGLE (menu-bar) ══ */
    #menu-bar {
      display: none;
      position: fixed;
      top: 14px;
      left: 10px;
      z-index: 1300;
      transition: left .25s ease;
    }
    #menu-bar .btn {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--border-color);
      box-shadow: 0 2px 10px rgba(11,31,102,.2);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; padding: 0;
    }
    #menu-bar .btn i {
      font-size: 13px;
      transition: transform .25s ease;
    }

    @media (max-width: 900px) {
      .bit-shell { flex-direction: column; }
      .bit-sidebar {
        position: fixed; top: 0; left: -85vw; width: min(280px, 85vw); height: 100vh;
        z-index: 1200; transition: left .25s ease;
      }
      .bit-sidebar.open { left: 0; }
      .bit-mobile-topbar {
        display: flex; align-items: center; justify-content: space-between;
        position: sticky; top: 0; z-index: 1100;
        background: #fff; border-bottom: 1px solid var(--border-color);
        padding: 12px 16px;
      }
      .bit-mobile-topbar button {
        border: 1px solid var(--border-color); background: #fff; border-radius: 8px;
        width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
        color: var(--primary); font-size: 16px; cursor: pointer;
      }
      .bit-sidebar-overlay {
        display: none; position: fixed; inset: 0; background: rgba(8,21,71,.4);
        z-index: 1150;
      }
      .bit-sidebar-overlay.show { display: block; }

      #menu-bar { display: block; }

      /* Bigger, more comfortable tap targets on mobile */
      .bit-nav-link { padding: 12px 14px; font-size: 14px; }
      .sem-header { padding: 11px 14px; font-size: 13.5px; }
      .sem-submenu a { padding: 10px 14px 10px 40px; font-size: 13px; }
      .bit-sidebar-user { padding: 12px; }
      .bit-logout-btn { padding: 12px; font-size: 13px; }
      .bit-content { width: 100%; }
    }

    @media (max-width: 420px) {
      .bit-brand-text strong { font-size: 13.5px; }
      .bit-footer { font-size: 10.5px; padding: 14px; }
    }

    body.bit-no-scroll { overflow: hidden; }
  </style>
  <title>BIT ADMIN</title>
</head>
<body>
