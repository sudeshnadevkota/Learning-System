          Texas Learning Portal &nbsp;&middot;&nbsp; 2021/22
        </div>
      </div>

    </div>

    <script>
function bitToggleSem(headerEl) {
    var item = headerEl.parentElement;
    var isOpen = item.classList.contains('open');

    document.querySelectorAll('.sem-item').forEach(function (el) {
        el.classList.remove('open');
        var h = el.querySelector('.sem-header');
        if (h) h.classList.remove('active');
    });

    if (!isOpen) {
        item.classList.add('open');
        headerEl.classList.add('active');
        sessionStorage.setItem('bitOpenSem', item.getAttribute('data-sem'));
    } else {
        sessionStorage.removeItem('bitOpenSem');
    }
}

/* ── Sidebar open/close (mobile) ──
   setSidebarState is the single source of truth. bitOpenSidebar / bitCloseSidebar
   are kept as-is for backward compatibility (used by the overlay's onclick),
   and the new floating #menu-bar button + the topbar button both call
   toggleSidebar(), which flips whatever the current state is. */
function setSidebarState(isOpen) {
    var sidebar = document.getElementById('bitSidebar');
    var overlay = document.getElementById('bitOverlay');
    var menuBar = document.getElementById('menu-bar');
    var icon = document.getElementById('icon');

    if (!sidebar) return;

    sidebar.classList.toggle('open', isOpen);
    if (overlay) overlay.classList.toggle('show', isOpen);
    document.body.classList.toggle('bit-no-scroll', isOpen && window.innerWidth <= 900);

    if (menuBar && window.innerWidth <= 900) {
        menuBar.style.left = isOpen ? '250px' : '10px';
    }
    if (icon) {
        icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }
}

function toggleSidebar() {
    var sidebar = document.getElementById('bitSidebar');
    setSidebarState(!(sidebar && sidebar.classList.contains('open')));
}

function bitOpenSidebar() { setSidebarState(true); }
function bitCloseSidebar() { setSidebarState(false); }

document.addEventListener('DOMContentLoaded', function () {
    // Highlight the current page's link and auto-open its semester group
    var links = document.querySelectorAll('.sem-submenu a');
    var current = (window.location.pathname + window.location.search).toLowerCase();
    var matchedSemEl = null;

    links.forEach(function (a) {
        var href = a.getAttribute('href');
        if (!href) return;
        try {
            var full = new URL(href, window.location.origin);
            var target = (full.pathname + full.search).toLowerCase();
            if (target === current) {
                a.classList.add('active-link');
                matchedSemEl = a.closest('.sem-item');
            }
        } catch (e) { /* ignore malformed hrefs */ }
    });

    if (matchedSemEl) {
        matchedSemEl.classList.add('open');
        matchedSemEl.querySelector('.sem-header').classList.add('active');
    } else {
        var saved = sessionStorage.getItem('bitOpenSem');
        if (saved) {
            var el = document.querySelector('.sem-item[data-sem="' + saved + '"]');
            if (el) { el.classList.add('open'); el.querySelector('.sem-header').classList.add('active'); }
        }
    }

    // Highlight Dashboard link when on dash.aspx
    if (current.indexOf('dash.aspx') !== -1) {
        var dashLink = document.querySelector('.bit-nav-link');
        if (dashLink) dashLink.classList.add('active');
    }

    // Sidebar starts closed on mobile - make sure menu-bar/icon reflect that
    setSidebarState(false);

    // Keep things sane when rotating device / resizing across the breakpoint
    var lastWasMobile = window.innerWidth <= 900;
    window.addEventListener('resize', function () {
        var isMobile = window.innerWidth <= 900;
        if (isMobile !== lastWasMobile) {
            setSidebarState(false);
            lastWasMobile = isMobile;
        }
    });
});
</script>
            <script>
                (function () {
                    var body = document.body;
                    var openBtn = document.getElementById('btnOpenSidebar');
                    var closeBtn = document.getElementById('btnCloseSidebar');
                    var backdrop = document.getElementById('sidebarBackdrop');

                    function openSidebar() { body.classList.add('c-sidebar-open'); }
                    function closeSidebar() { body.classList.remove('c-sidebar-open'); }

                    if (openBtn) openBtn.addEventListener('click', openSidebar);
                    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
                    if (backdrop) backdrop.addEventListener('click', closeSidebar);
                })();
            </script>
   <script>
       (function () {
           var toggle = document.getElementById('sidebarUserToggle');
           if (!toggle) return;

           toggle.addEventListener('click', function (e) {
               e.stopPropagation();
               toggle.classList.toggle('open');
           });

           document.addEventListener('click', function () {
               toggle.classList.remove('open');
           });

           // Prevent the popup itself from closing when clicked inside
           var popup = toggle.querySelector('.c-user-popup');
           if (popup) {
               popup.addEventListener('click', function (e) { e.stopPropagation(); });
           }
       })();
   </script>

   <!-- NEW: Manage Notices form logic (semester dropdown + file drop zone).
        Lives here instead of inside NoticeManageControl.ascx because that control
        gets swapped into the UpdatePanel via AJAX, and inline <script> tags inside
        AJAX-injected content don't reliably execute. This script is defined once,
        on the real page load, and re-runs itself after every async postback via
        PageRequestManager's endRequest event — which always fires, regardless of
        what got swapped in. -->
   <script>
       (function () {
           function populateSemesters(selectedClass) {
               var ddlSem = document.querySelector('[id$="ddlSemester"]');
               if (!ddlSem) return;
               ddlSem.innerHTML = '';

               var allOpt = document.createElement('option');
               allOpt.value = 'ALL';
               allOpt.innerHTML = 'All Semesters';
               ddlSem.appendChild(allOpt);

               var limit = (['MCS', 'MBA'].includes(selectedClass)) ? 4 : 8;
               for (var i = 1; i <= limit; i++) {
                   var opt = document.createElement('option');
                   opt.value = i;
                   opt.innerHTML = 'Semester ' + i;
                   ddlSem.appendChild(opt);
               }
           }
           // Exposed globally so ddlClass's onchange="updateSemesters(this.value)" markup still works.
           window.updateSemesters = populateSemesters;

           function initNoticeManagePanel() {
               var ddlClass = document.querySelector('[id$="ddlClass"]');
               var ddlSem = document.querySelector('[id$="ddlSemester"]');
               if (!ddlClass || !ddlSem) return; // Manage Notices panel isn't the active one right now

               var hidClass = document.querySelector('[id$="hidPresetClass"]');
               var hidSem = document.querySelector('[id$="hidPresetSemester"]');
               var presetClass = hidClass ? hidClass.value : '';
               var presetSem = hidSem ? hidSem.value : '';

               if (presetClass) {
                   populateSemesters(presetClass);
                   if (presetSem) ddlSem.value = presetSem;
               }

               initDropZone();
           }

           function initDropZone() {
               var dropZone = document.getElementById('dropZone');
               var fileInput = document.querySelector('[id$="fileAttachment"]');
               var filePreview = document.getElementById('filePreview');
               var fileNameEl = document.getElementById('fileName');
               var fileSizeEl = document.getElementById('fileSize');
               var btnBrowse = document.getElementById('btnBrowse');
               var btnClear = document.getElementById('btnClearFile');
               if (!dropZone || !fileInput || !btnBrowse || !btnClear) return;

               // Avoid double-binding listeners if this ever runs twice on the same DOM
               if (dropZone.dataset.wired === '1') return;
               dropZone.dataset.wired = '1';

               function formatSize(bytes) {
                   if (bytes < 1024) return bytes + ' B';
                   if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
                   return (bytes / 1048576).toFixed(2) + ' MB';
               }
               function showFile(file) {
                   if (fileNameEl) fileNameEl.textContent = file.name;
                   if (fileSizeEl) fileSizeEl.textContent = formatSize(file.size);
                   if (filePreview) filePreview.classList.add('visible');
                   dropZone.classList.add('has-file');
                   dropZone.classList.remove('dragover');
               }
               function clearFile() {
                   fileInput.value = '';
                   if (filePreview) filePreview.classList.remove('visible');
                   dropZone.classList.remove('has-file');
                   if (fileNameEl) fileNameEl.textContent = '';
                   if (fileSizeEl) fileSizeEl.textContent = '';
               }

               btnBrowse.addEventListener('click', function (e) { e.stopPropagation(); fileInput.click(); });
               dropZone.addEventListener('click', function (e) { if (e.target !== btnBrowse && e.target !== btnClear) fileInput.click(); });
               fileInput.addEventListener('change', function () { if (this.files && this.files[0]) showFile(this.files[0]); });
               btnClear.addEventListener('click', function (e) { e.stopPropagation(); clearFile(); });
               dropZone.addEventListener('dragover', function (e) { e.preventDefault(); dropZone.classList.add('dragover'); });
               dropZone.addEventListener('dragleave', function (e) { if (!dropZone.contains(e.relatedTarget)) dropZone.classList.remove('dragover'); });
               dropZone.addEventListener('drop', function (e) {
                   e.preventDefault(); dropZone.classList.remove('dragover');
                   var files = e.dataTransfer.files;
                   if (files && files[0]) {
                       try { var dt = new DataTransfer(); dt.items.add(files[0]); fileInput.files = dt.files; } catch (err) { }
                       showFile(files[0]);
                   }
               });
           }

           // Runs on the very first full page load...
           document.addEventListener('DOMContentLoaded', initNoticeManagePanel);

           // ...and again after EVERY async (UpdatePanel) postback, guaranteed by the
           // AJAX framework regardless of whether inline <script> tags in the swapped
           // content actually executed.
           if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
               Sys.WebForms.PageRequestManager.getInstance().add_endRequest(initNoticeManagePanel);
           }
       })();
   </script>
  </form>
</body>
</html>
