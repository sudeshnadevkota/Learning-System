    <a href="~/Bit_Admin/course_content.aspx?subject=BIT_SPM" runat="server">Software Project Management</a>
  </div>
</div>

<div class="sem-item" data-sem="seventh">
  <div class="sem-header" onclick="bitToggleSem(this)">
    <span class="sem-badge">7</span><span class="sem-name">Seventh Semester</span>
    <i class="ti ti-chevron-down sem-chevron"></i>
  </div>
  <div class="sem-submenu">
    <a href="~/Bit_Admin/course_content.aspx?subject=BIT_SSA" runat="server">System Software Administration</a>
    <a href="~/Bit_Admin/course_content.aspx?subject=BIT_MIS" runat="server">Management Information System</a>
    <a href="~/Bit_Admin/course_content.aspx?subject=BIT_CC" runat="server">Cloud Computing</a>
  </div>
</div>

          <% if (IsDepartmentAdmin) { %>
          <div class="bit-eyebrow">Quick Actions</div>

          <asp:LinkButton ID="lnkAppointUser" runat="server" CssClass="bit-nav-link"
     CommandArgument="AppointUser" OnClick="NavLink_Click">
     <i class="ti ti-user-cog"></i> Appoint User
 </asp:LinkButton>
          <a href="~/Bit_Admin/RegisterStudent.aspx" runat="server" class="bit-nav-link"><i class="ti ti-users-plus"></i> Register Student</a>

          <asp:LinkButton ID="lnkStaffManage" runat="server" CssClass="bit-nav-link"
              CommandArgument="StaffManage" OnClick="NavLink_Click">
              <i class="ti ti-user-cog"></i> Manage Staff
          </asp:LinkButton>

             <asp:LinkButton ID="lnkNoticeManage" runat="server" CssClass="bit-nav-link"
        CommandArgument="NoticeManage" OnClick="NavLink_Click">
        <i class="ti ti-user-cog"></i> Manage Notice
    </asp:LinkButton>
<%--          <a href="~/Bit_Admin/Reports.aspx" runat="server" class="bit-nav-link"><i class="ti ti-chart-bar"></i> Reports</a>--%>

      <%--    <asp:LinkButton ID="lnkDeptSettings" runat="server" CssClass="bit-nav-link"
              CommandArgument="DeptSettings" OnClick="NavLink_Click">
              <i class="ti ti-settings"></i> Department Settings
          </asp:LinkButton>--%>
          <% } %>
        </div>

        <div class="bit-sidebar-foot">
          <div class="bit-sidebar-user">
            <div class="bit-sidebar-avatar"><i class="ti ti-user"></i></div>
            <div>
              <div class="bit-sidebar-user-name"><%= Session["Username"] %></div>
              <div class="bit-sidebar-user-role"><%= IsDepartmentAdmin ? "Department Admin" : "Staff" %></div>
            </div>
          </div>
          <asp:LinkButton ID="LinkButton1" runat="server" OnClick="LinkOut_Click" CausesValidation="False" CssClass="bit-logout-btn">
            <i class="ti ti-logout"></i> Logout
          </asp:LinkButton>
        </div>
      </aside>

      <!-- ── CONTENT ── -->
      <div class="bit-content">
        <div class="bit-mobile-topbar">
          <button type="button" onclick="toggleSidebar()"><i class="ti ti-menu-2"></i></button>
          <strong style="color:var(--primary); font-size:14px;">BIT Admin</strong>
          <span style="width:36px;"></span>
        </div>

        <asp:Panel ID="pnlStaticContent" runat="server">
